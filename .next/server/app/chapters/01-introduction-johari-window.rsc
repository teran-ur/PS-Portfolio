ded-full bg-[#FFF1EB] text-[#FF6B35] font-bold tracking-wider","children":["Module ","01"]}],["$","span",null,{"className":"text-xs font-mono uppercase text-[#171717] font-semibold","children":"Self-Awareness & Mind"}],["$","span",null,{"className":"text-[#8E8E93]","children":"•"}],["$","span",null,{"className":"flex items-center space-x-1.5 text-xs text-[#686868] font-mono","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-clock w-3.5 h-3.5 text-[#FF6B35]","children":[["$","circle","1mglay",{"cx":"12","cy":"12","r":"10"}],["$","polyline","68esgv",{"points":"12 6 12 12 16 14"}],"$undefined"]}],["$","span",null,{"children":["8 min read"," read"]}]]}]]}],["$","div",null,{"className":"space-y-2 relative z-10","children":[["$","h1",null,{"className":"text-4xl sm:text-5xl md:text-6xl font-display font-extrabold text-[#171717] tracking-tight leading-[1]","children":"Introduction to Professional Skills & Johari Window"}],["$","p",null,{"className":"text-xl font-display font-medium text-[#404040] pt-1","children":"Self-Awareness, Character Pillars & Dynamic Interpersonal Growth"}]]}],["$","div",null,{"className":"pt-4 flex flex-wrap items-center justify-between gap-4 text-xs font-mono border-t border-[#E5E5E2] relative z-10","children":[["$","div",null,{"className":"flex items-center space-x-3","children":[["$","span",null,{"className":"text-[#FF6B35] font-bold","children":"Academic Lead:"}],["$","span",null,{"className":"font-semibold text-[#171717]","children":"Mrs. Ishara Raviharee Weerasinghe"}],["$","span",null,{"className":"text-[#8E8E93]","children":["(","Senior Lecturer in English | Lecturer In Charge",")"]}]]}],["$","div",null,{"className":"text-[#8E8E93]","children":"SLIIT City Uni • Professional Skills Assessment Standard"}]]}]]}],["$","div",null,{"className":"p-8 md:p-10 rounded-3xl bg-white border border-[#E5E5E2] shadow-subtle space-y-6","children":[["$","div",null,{"children":[["$","span",null,{"className":"text-xs font-mono uppercase tracking-widest text-[#FF6B35] font-bold block mb-2","children":"Curriculum Overview & Context"}],["$","p",null,{"className":"text-base sm:text-lg text-[#171717] leading-relaxed font-sans font-medium","children":"Establishes the foundational distinction between technical, soft, and transferable competencies. Explores the internal compass shaping workplace character and introduces the 1955 Johari Window model for expanding interpersonal awareness."}]]}],["$","div",null,{"className":"pt-6 border-t border-[#E5E5E2] space-y-3","children":[["$","div",null,{"className":"flex items-center space-x-2","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-graduation-cap w-4 h-4 text-[#FF6B35]","children":[["$","path","j76jl0",{"d":"M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"}],["$","path","1lu8f3",{"d":"M22 10v6"}],["$","path","1r8lef",{"d":"M6 12.5V16a6 3 0 0 0 12 0v-3.5"}],"$undefined"]}],["$","h4",null,{"className":"text-xs font-mono uppercase tracking-widest text-[#171717] font-bold","children":"Core Competencies & Learning Objectives"}]]}],["$","ul",null,{"className":"grid grid-cols-1 md:grid-cols-2 gap-3 text-xs sm:text-sm text-[#404040]","children":[["$","li","0",{"className":"flex items-start space-x-2.5 font-sans","children":[["$","span",null,{"className":"text-[#FF6B35] font-mono font-bold mt-0.5 shrink-0","children":"→"}],["$","span",null,{"children":"Distinguish between Technical Skills, Soft Skills, and Transferable Meta-Competencies."}]]}],["$","li","1",{"className":"flex items-start space-x-2.5 font-sans","children":[["$","span",null,{"className":"text-[#FF6B35] font-mono font-bold mt-0.5 shrink-0","children":"→"}],["$","span",null,{"children":"Analyze the four connected elements of Character Architecture: Values, Beliefs, Attitudes, and Outcomes."}]]}],["$","li","2",{"className":"flex items-start space-x-2.5 font-sans","children":[["$","span",null,{"className":"text-[#FF6B35] font-mono font-bold mt-0.5 shrink-0","children":"→"}],["$","span",null,{"children":"Apply the Johari Window framework to plot personal strengths across the four quadrants."}]]}],["$","li","3",{"className":"flex items-start space-x-2.5 font-sans","children":[["$","span",null,{"className":"text-[#FF6B35] font-mono font-bold mt-0.5 shrink-0","children":"→"}],["$","span",null,{"children":"Understand how soliciting feedback shrinks the Blind Spot and how candid disclosure shrinks the Façade."}]]}],["$","li","4",{"className":"flex items-start space-x-2.5 font-sans","children":[["$","span",null,{"className":"text-[#FF6B35] font-mono font-bold mt-0.5 shrink-0","children":"→"}],["$","span",null,{"children":"Cultivate a Growth Mindset and an Internal Locus of Control for organizational resilience."}]]}]]}]]}]]}],["$","div",null,{"className":"space-y-8","children":[["$","section",null,{"className":"py-8 border-b border-[#E5E5E2] space-y-6","children":[["$","div",null,{"className":"space-y-1","children":[["$","h2",null,{"className":"text-2xl sm:text-3xl font-display font-bold text-[#171717] tracking-tight","children":"Workplace Skills Taxonomy"}],["$","p",null,{"className":"text-sm font-mono text-[#FF6B35] font-semibold","children":"The Three Dimensions of Professional Capability"}]]}],["$","div",null,{"className":"space-y-4 max-w-3xl","children":[["$","p","0",{"className":"text-base text-[#404040] leading-relaxed font-sans","children":"In the modern knowledge economy, career excellence is not determined by coding or technical prowess alone. The curriculum establishes a rigorous tripartite classification of competencies required to thrive in multidisciplinary teams."}],["$","p","1",{"className":"text-base text-[#404040] leading-relaxed font-sans","children":"While hard technical knowledge gets the candidate an interview, it is soft and transferable competencies that ensure long-term retention, cross-functional respect, and executive promotions."}]]}],["$","div",null,{"className":"space-y-3 pl-4 sm:pl-6 border-l-2 border-[#FF6B35]/40 my-6 max-w-3xl","children":[["$","div","0",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["Technical Skills (Hard Skills)",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Job-specific, domain-bound competencies such as software programming, system architecture, database design, and algorithmic optimization."}]]}],["$","div","1",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["Soft Skills (Interpersonal)",":"]}],["$","span",null,{"className":"text-[#555555]","children":"People-oriented attributes including emotional intelligence, empathetic listening, constructive feedback delivery, and collaborative teamwork."}]]}],["$","div","2",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["Transferable Skills",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Versatile meta-skills that transcend specific roles or industries: structured problem-solving, situational adaptability, and disciplined time management."}]]}]]}],"$undefined","$undefined"]}],["$","section",null,{"className":"py-8 border-b border-[#E5E5E2] space-y-6","children":[["$","div",null,{"className":"space-y-1","children":[["$","h2",null,{"className":"text-2xl sm:text-3xl font-display font-bold text-[#171717] tracking-tight","children":"The Pillars of Character Framework"}],["$","p",null,{"className":"text-sm font-mono text-[#FF6B35] font-semibold","children":"How Internal Compasses Shape External Reputation"}]]}],["$","div",null,{"className":"space-y-4 max-w-3xl","children":[["$","p","0",{"className":"text-base text-[#404040] leading-relaxed font-sans","children":"Professional reputation is not merely an outward presentation; it is an organic reflection of four deeply interconnected internal dimensions."}],["$","p","1",{"className":"text-base text-[#404040] leading-relaxed font-sans","children":"When our core values genuinely align with our daily actions, we establish unshakeable integrity and earn psychological safety within high-stakes project environments."}]]}],"$undefined",["$","div",null,{"className":"my-8 overflow-x-auto rounded-2xl border border-[#E5E5E2] bg-white shadow-subtle","children":[["$","table",null,{"className":"w-full text-left text-xs md:text-sm border-collapse","children":[["$","thead",null,{"children":["$","tr",null,{"className":"bg-[#F7F7F5] border-b border-[#E5E5E2]","children":[["$","th","0",{"className":"py-3.5 px-4 font-mono font-semibold uppercase tracking-wider text-[#171717] text-[11px]","children":"Dimension"}],["$","th","1",{"className":"py-3.5 px-4 font-mono font-semibold uppercase tracking-wider text-[#171717] text-[11px]","children":"Core Components"}],["$","th","2",{"className":"py-3.5 px-4 font-mono font-semibold uppercase tracking-wider text-[#171717] text-[11px]","children":"Workplace Manifestation"}]]}]}],["$","tbody",null,{"className":"divide-y divide-[#E5E5E2] bg-white","children":[["$","tr","0",{"className":"hover:bg-[#F7F7F5]/50 transition-colors","children":[["$","td","0",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Values"}],["$","td","1",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Honesty, Integrity, Responsibility, Fairness, Respect"}],["$","td","2",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Uncompromising adherence to truth in reporting bugs, meeting deadlines, and respecting colleagues."}]]}],["$","tr","1",{"className":"hover:bg-[#F7F7F5]/50 transition-colors","children":[["$","td","0",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Beliefs"}],["$","td","1",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Growth Mindset, High Self-Efficacy, Internal Locus of Control"}],["$","td","2",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Viewing difficult technical bugs as learning opportunities rather than personal inadequacies."}]]}],["$","tr","2",{"className":"hover:bg-[#F7F7F5]/50 transition-colors","children":[["$","td","0",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Attitudes"}],["$","td","1",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Constructive Optimism, Intellectual Humility, Tolerance"}],["$","td","2",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Welcoming peer code reviews with openness, rejecting defensive cognitive reactions."}]]}],["$","tr","3",{"className":"hover:bg-[#F7F7F5]/50 transition-colors","children":[["$","td","0",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Character"}],["$","td","1",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Respectfulness, Caring, Moral & Ethical Courage"}],["$","td","2",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Standing up for architectural quality, supporting struggling peers, and honoring ethical obligations."}]]}]]}]]}],"$undefined"]}],"$undefined"]}],["$","section",null,{"className":"py-8 border-b border-[#E5E5E2] space-y-6","children":[["$","div",null,{"className":"space-y-1","children":[["$","h2",null,{"className":"text-2xl sm:text-3xl font-display font-bold text-[#171717] tracking-tight","children":"The Johari Window Model (Luft & Ingham, 1955)"}],["$","p",null,{"className":"text-sm font-mono text-[#FF6B35] font-semibold","children":"A Mathematical & Psychological Matrix of Awareness"}]]}],["$","div",null,{"className":"space-y-4 max-w-3xl","children":[["$","p","0",{"className":"text-base text-[#404040] leading-relaxed font-sans","children":"Conceived by Joseph Luft and Harrington Ingham in 1955, the Johari Window is a cognitive tool for mapping and accelerating interpersonal awareness. It compares what an individual knows about themselves against what others perceive in them."}],["$","p","1",{"className":"text-base text-[#404040] leading-relaxed font-sans","children":"The overarching objective in professional leadership is to maximize the Open Area (Arena) while intentionally reducing the Blind Area through requested feedback and the Hidden Area through judicious self-disclosure."}]]}],["$","div",null,{"className":"space-y-3 pl-4 sm:pl-6 border-l-2 border-[#FF6B35]/40 my-6 max-w-3xl","children":[["$","div","0",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["1. Open Area (Arena)",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Known to Self & Known to Others. The zone of transparent collaboration, established mutual trust, and shared clarity. High arena size correlates with superior team velocity."}]]}],["$","div","1",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["2. Blind Area (Blind Spot)",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Unknown to Self & Known to Others. Unconscious habits, vocal ticks, or latent mediation strengths. Can only be identified and shrunk through actively soliciting candid feedback."}]]}],["$","div","2",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["3. Hidden Area (Façade)",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Known to Self & Unknown to Others. Private anxieties, fears of negative appraisal, or hidden talents. Reduced safely through gradual, authentic self-disclosure."}]]}],["$","div","3",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["4. Unknown Area",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Unknown to Self & Unknown to Others. Dormant potential, undiscovered leadership in corporate crises, and latent capabilities awakened only through novel challenges."}]]}]]}],"$undefined",["$","div",null,{"className":"my-8 p-6 sm:p-8 rounded-2xl bg-[#FFF1EB] border-l-4 border-l-[#FF6B35] relative","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-quote w-8 h-8 text-[#FF6B35]/25 absolute top-5 right-5","children":[["$","path","rib7q0",{"d":"M16 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"}],["$","path","1ymkrd",{"d":"M5 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"}],"$undefined"]}],["$","span",null,{"className":"text-xs font-mono uppercase tracking-wider text-[#FF6B35] font-bold block mb-2","children":"Pedagogical Epigraph"}],["$","blockquote",null,{"className":"text-base sm:text-lg font-serif italic text-[#171717] leading-relaxed max-w-2xl","children":["“","Technical skills get you the interview, but soft and transferable skills help you keep the job and earn leadership promotions.","”"]}],["$","div",null,{"className":"text-xs font-mono text-[#686868] mt-3","children":["— ","Mrs. Ishara Raviharee Weerasinghe"]}]]}]]}]]}],["$","$L3",null,{"componentId":"johari-window"}],["$","$L4",null,{"synthesis":{"topicMeaning":"This topic defines the foundational architecture of workplace competence by distinguishing between job-specific technical skills, interpersonal soft skills, and cross-functional transferable abilities. Central to this is the Johari Window (Luft & Ingham, 1955), a cognitive psychological model mapping self-awareness across four distinct interpersonal quadrants based on what is known and unknown to oneself and others.","coreConceptsLearned":["Tripartite Skills Taxonomy: Hard technical skills open doors, but soft and transferable skills ensure long-term retention and leadership.","The Pillars of Character Framework: How internal Values, Beliefs, and Attitudes organically produce external workplace Character.","Johari Window 4 Quadrants: Open Area (Arena), Blind Area (Blind Spot), Hidden Area (Façade), and Unknown Area.","Dynamic Quadrant Modification: Proactively shrinking Blind Spots through soliciting feedback and reducing Façades through judicious disclosure.","Mindset Theory (Carol Dweck, 2006): Embracing a Growth Mindset and Internal Locus of Control over fixed defensiveness."],"whyItMattersInIT":"Modern software engineering is an intrinsically collaborative human discipline. In high-velocity agile sprints, code reviews, and cross-functional architecture meetings, a developer who lacks self-awareness perceives peer critiques as personal attacks. This triggers defensive posturing, siloed work, and hidden bugs. Expanding the Johari Open Arena builds the psychological safety necessary for rapid blameless postmortems and resilient software architectures.","activityConnections":[{"activityTitle":"Agile Teamwork & Peer Reviews in HDIT Coursework","activityType":"Academic (SLIIT City Uni)","description":"During collaborative development assignments at SLIIT City Uni, applying Johari principles helped transition code reviews from stressful confrontations into collaborative learning rituals. Soliciting peer feedback revealed hidden oversights in database query structures and UI edge cases."},{"activityTitle":"Co-Founder Alignment & Transparency at LA'CEDRA","activityType":"Entrepreneurship (LA'CEDRA)","description":"As Co-Founder of LA'CEDRA, establishing transparent communication with partners regarding technical delivery timelines and personal workload capacity prevented misalignment. Shrinking the Hidden Area (Façade) ensured operational trust when scoping client projects."}],"practicalApplications":[{"scenario":"Software Pull Request & Code Review Checkpoints","implementation":"Explicitly requesting teammates to audit code for maintainability and readability, intentionally shrinking the Blind Spot rather than defending stylistic preferences."},{"scenario":"Sprint Retrospectives & Client Requirement Discovery","implementation":"Conducting blameless retrospectives after shipping features, openly sharing technical bottlenecks, and expanding the shared team Open Arena."}],"personalReflection":{"narrative":"Earlier in my programming journey, I occasionally treated critical feedback on my code or architecture as a challenge to my competence. Studying the Johari Window made me realize that defensiveness simply protects an artificial Façade while leaving massive Blind Spots unaddressed. Accepting peer critiques as objective data has dramatically accelerated both my technical craftsmanship and collaborative poise.","editableInputPrompt":"[Editable Reflection Slot: Add your personal thoughts on a specific moment at SLIIT City Uni or LA'CEDRA where peer feedback altered your technical perspective or revealed a blind spot.]"},"areasForImprovement":["Soliciting critical peer feedback earlier in the development lifecycle rather than waiting until final project submission milestones.","Communicating private operational blockers more promptly to co-founders and team members to minimize unnecessary hidden stress."],"keyTakeaways":["The size of a development team's Open Arena directly correlates with software delivery velocity and psychological safety.","Technical prowess qualifies a developer for an interview; self-awareness and feedback receptivity retain the job and build leadership trust."]},"chapterNumber":"01","chapterTitle":"Introduction to Professional Skills & Johari Window"}],["$","div",null,{"className":"my-12 pt-8 border-t border-[#E5E5E2] space-y-6","children":[["$","div",null,{"className":"flex items-center space-x-2","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark w-4 h-4 text-[#FF6B35]","children":[["$","path","1fy3hk",{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"}],"$undefined"]}],["$","h3",null,{"className":"text-xs font-mono uppercase tracking-widest text-[#FF6B35] font-bold","children":"Core Academic Takeaways"}]]}],["$","div",null,{"className":"grid grid-cols-1 md:grid-cols-2 gap-6","children":[["$","div","0",{"className":"p-5 rounded-2xl bg-white border border-[#E5E5E2] flex items-start space-x-3 shadow-subtle hover:border-[#171717] transition-all","children":[["$","span",null,{"className":"font-mono text-xs font-bold text-[#FF6B35] shrink-0 mt-0.5","children":["0",1,"."]}],["$","p",null,{"className":"text-xs sm:text-sm text-[#171717] leading-relaxed font-sans","children":"Technical skills open corporate doors; soft and transferable meta-skills secure long-term leadership retention."}]]}],["$","div","1",{"className":"p-5 rounded-2xl bg-white border border-[#E5E5E2] flex items-start space-x-3 shadow-subtle hover:border-[#171717] transition-all","children":[["$","span",null,{"classNam