ed-3xl bg-white border border-[#E5E5E2] shadow-subtle space-y-6","children":[["$","div",null,{"children":[["$","span",null,{"className":"text-xs font-mono uppercase tracking-widest text-[#FF6B35] font-bold block mb-2","children":"Curriculum Overview & Context"}],["$","p",null,{"className":"text-base sm:text-lg text-[#171717] leading-relaxed font-sans font-medium","children":"Deconstructs the anatomical elements of high-impact professional emails. Establishes the 7 Golden Rules of Netiquette, addresses permanent digital archiving risks, and provides a dictionary of essential corporate abbreviations."}]]}],["$","div",null,{"className":"pt-6 border-t border-[#E5E5E2] space-y-3","children":[["$","div",null,{"className":"flex items-center space-x-2","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-graduation-cap w-4 h-4 text-[#FF6B35]","children":[["$","path","j76jl0",{"d":"M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"}],["$","path","1lu8f3",{"d":"M22 10v6"}],["$","path","1r8lef",{"d":"M6 12.5V16a6 3 0 0 0 12 0v-3.5"}],"$undefined"]}],["$","h4",null,{"className":"text-xs font-mono uppercase tracking-widest text-[#171717] font-bold","children":"Core Competencies & Learning Objectives"}]]}],["$","ul",null,{"className":"grid grid-cols-1 md:grid-cols-2 gap-3 text-xs sm:text-sm text-[#404040]","children":[["$","li","0",{"className":"flex items-start space-x-2.5 font-sans","children":[["$","span",null,{"className":"text-[#FF6B35] font-mono font-bold mt-0.5 shrink-0","children":"→"}],["$","span",null,{"children":"Master the structural anatomy of an executive email: To/Cc/Bcc, Subject, Salutation, Body, CTA, Signature."}]]}],["$","li","1",{"className":"flex items-start space-x-2.5 font-sans","children":[["$","span",null,{"className":"text-[#FF6B35] font-mono font-bold mt-0.5 shrink-0","children":"→"}],["$","span",null,{"children":"Enforce the 7 Golden Rules of Netiquette to protect organizational and individual reputation."}]]}],["$","li","2",{"className":"flex items-start space-x-2.5 font-sans","children":[["$","span",null,{"className":"text-[#FF6B35] font-mono font-bold mt-0.5 shrink-0","children":"→"}],["$","span",null,{"children":"Understand the legal and permanence risks of digital messaging (The Forwarding Rule)."}]]}],["$","li","3",{"className":"flex items-start space-x-2.5 font-sans","children":[["$","span",null,{"className":"text-[#FF6B35] font-mono font-bold mt-0.5 shrink-0","children":"→"}],["$","span",null,{"children":"Apply common corporate acronyms (ASAP, FYI, COB/EOD, TBD, RSVP) with contextual accuracy."}]]}]]}]]}]]}],["$","div",null,{"className":"space-y-8","children":[["$","section",null,{"className":"py-8 border-b border-[#E5E5E2] space-y-6","children":[["$","div",null,{"className":"space-y-1","children":[["$","h2",null,{"className":"text-2xl sm:text-3xl font-display font-bold text-[#171717] tracking-tight","children":"Anatomy of an Executive Professional Email"}],["$","p",null,{"className":"text-sm font-mono text-[#FF6B35] font-semibold","children":"The 7 Building Blocks of High-Stakes Correspondence"}]]}],["$","div",null,{"className":"space-y-4 max-w-3xl","children":[["$","p","0",{"className":"text-base text-[#404040] leading-relaxed font-sans","children":"An email is not a casual text message. It is a formal, legally archivable representation of your professional brand. Poor formatting, careless typos, or missing calls to action cause costly operational misunderstandings."}]]}],["$","div",null,{"className":"space-y-3 pl-4 sm:pl-6 border-l-2 border-[#FF6B35]/40 my-6 max-w-3xl","children":[["$","div","0",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["1. Recipient Field Protocol (To / Cc / Bcc)",":"]}],["$","span",null,{"className":"text-[#555555]","children":"'To' is strictly reserved for primary action owners. 'Cc' (Carbon Copy) is for informational awareness only. 'Bcc' (Blind Carbon Copy) protects recipient privacy in large distributions. Strict prohibition of careless 'Reply All'."}]]}],["$","div","1",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["2. High-Impact Subject Line",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Concise, descriptive, and action-oriented. Never write 'Hello' or full sentences. Example: '[Action Required] API Gateway Migration Architecture Review - Oct 24'."}]]}],["$","div","2",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["3. Role-Appropriate Salutation",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Formal opening matching the recipient's institutional status: 'Dear Professor Jayawardane,', 'Dear Ms. Maneesha,', or 'Dear Mr. Perera,'. Avoid casual openings ('Hey guys') in formal settings."}]]}],["$","div","3",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["4. Respectful Contextual Hook",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Clear opening sentence setting immediate context without superfluous pleasantries. Example: 'I am writing to deliver the sprint retrospective report as agreed during Tuesday's sync.'"}]]}],["$","div","4",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["5. Scannable Body Paragraphs",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Single-topic paragraphs separated by clean whitespace, utilizing bullet points for lists to allow rapid reading on mobile devices."}]]}],["$","div","5",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["6. Explicit Call to Action (CTA)",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Unambiguous statement identifying the required next step and firm deadline. Example: 'Please review and confirm your architectural approval by Friday at 3:00 PM.'"}]]}],["$","div","6",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["7. Professional Signature Block",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Formal sign-off ('Best regards,', 'Sincerely,'), full legal name, current title/academic year, department, institution, and professional contact links."}]]}]]}],"$undefined","$undefined"]}],["$","section",null,{"className":"py-8 border-b border-[#E5E5E2] space-y-6","children":[["$","div",null,{"className":"space-y-1","children":[["$","h2",null,{"className":"text-2xl sm:text-3xl font-display font-bold text-[#171717] tracking-tight","children":"The 7 Golden Rules of Online Netiquette"}],["$","p",null,{"className":"text-sm font-mono text-[#FF6B35] font-semibold","children":"Digital Protocols for Professional Respect"}]]}],["$","div",null,{"className":"space-y-4 max-w-3xl","children":[["$","p","0",{"className":"text-base text-[#404040] leading-relaxed font-sans","children":"Everything transmitted via institutional or corporate email servers can be subpoenaed, forwarded, or permanently archived. Conduct yourself with the assumption that your message may be read by the executive board."}]]}],["$","div",null,{"className":"space-y-3 pl-4 sm:pl-6 border-l-2 border-[#FF6B35]/40 my-6 max-w-3xl","children":[["$","div","0",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["1. Explicit Subject Lines Always",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Every message must feature a specific subject line containing project name and intent."}]]}],["$","div","1",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["2. Absolute Prohibition of ALL CAPS",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Typing in all caps ('PLEASE FINISH!') is universally perceived as aggressive digital shouting."}]]}],["$","div","2",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["3. Rigorous Proofreading Before Send",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Audit names, spelling, tone, and attachment references before clicking send."}]]}],["$","div","3",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["4. Professional Email Handle",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Use standard institutional or formal naming formats (e.g., first.last@domain.com, never gamer tags)."}]]}],["$","div","4",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["5. Attachment Discipline",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Ensure attachments are compressed, virus-free, cleanly named, and explicitly referenced in the body text."}]]}],["$","div","5",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["6. Respect Response SLAs",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Acknowledge receipt within 24 hours on business days, even if only to confirm work in progress."}]]}],["$","div","6",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["7. Tone Calibration",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Never write or transmit an email when emotionally agitated; apply the 24-hour cooling-off rule."}]]}]]}],"$undefined",["$","div",null,{"className":"my-8 p-6 sm:p-8 rounded-2xl bg-[#FFF1EB] border-l-4 border-l-[#FF6B35] relative","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-quote w-8 h-8 text-[#FF6B35]/25 absolute top-5 right-5","children":[["$","path","rib7q0",{"d":"M16 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"}],["$","path","1ymkrd",{"d":"M5 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"}],"$undefined"]}],["$","span",null,{"className":"text-xs font-mono uppercase tracking-wider text-[#FF6B35] font-bold block mb-2","children":"The Golden Netiquette Rule"}],["$","blockquote",null,{"className":"text-base sm:text-lg font-serif italic text-[#171717] leading-relaxed max-w-2xl","children":["“","Emails are permanent digital records: never write anything in an email that you would not be comfortable seeing projected onto a boardroom presentation screen.","”"]}],["$","div",null,{"className":"text-xs font-mono text-[#686868] mt-3","children":["— ","Schwalbe & Shipley (2017)"]}]]}]]}],["$","section",null,{"className":"py-8 border-b border-[#E5E5E2] space-y-6","children":[["$","div",null,{"className":"space-y-1","children":[["$","h2",null,{"className":"text-2xl sm:text-3xl font-display font-bold text-[#171717] tracking-tight","children":"Essential Corporate Abbreviations Dictionary"}],["$","p",null,{"className":"text-sm font-mono text-[#FF6B35] font-semibold","children":"Deciphering Workplace Communication Shorthand"}]]}],["$","div",null,{"className":"space-y-4 max-w-3xl","children":[["$","p","0",{"className":"text-base text-[#404040] leading-relaxed font-sans","children":"Corporate emails frequently employ standard business acronyms to streamline communications. Knowing when and how to utilize them is essential for modern workplace fluency."}]]}],"$undefined",["$","div",null,{"className":"my-8 overflow-x-auto rounded-2xl border border-[#E5E5E2] bg-white shadow-subtle","children":[["$","table",null,{"className":"w-full text-left text-xs md:text-sm border-collapse","children":[["$","thead",null,{"children":["$","tr",null,{"className":"bg-[#F7F7F5] border-b border-[#E5E5E2]","children":[["$","th","0",{"className":"py-3.5 px-4 font-mono font-semibold uppercase tracking-wider text-[#171717] text-[11px]","children":"Abbreviation"}],["$","th","1",{"className":"py-3.5 px-4 font-mono font-semibold uppercase tracking-wider text-[#171717] text-[11px]","children":"Full Term"}],["$","th","2",{"className":"py-3.5 px-4 font-mono font-semibold uppercase tracking-wider text-[#171717] text-[11px]","children":"Workplace Meaning & Usage Guideline"}]]}]}],["$","tbody",null,{"className":"divide-y divide-[#E5E5E2] bg-white","children":[["$","tr","0",{"className":"hover:bg-[#F7F7F5]/50 transition-colors","children":[["$","td","0",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"ASAP"}],["$","td","1",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"As Soon As Possible"}],["$","td","2",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"High-urgency task; use sparingly to prevent urgency fatigue."}]]}],["$","tr","1",{"className":"hover:bg-[#F7F7F5]/50 transition-colors","children":[["$","td","0",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"FYI"}],["$","td","1",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"For Your Information"}],["$","td","2",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Shared strictly for recipient awareness; no response or deliverable required."}]]}],["$","tr","2",{"className":"hover:bg-[#F7F7F5]/50 transition-colors","children":[["$","td","0",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"COB / EOD"}],["$","td","1",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Close of Business / End of Day"}],["$","td","2",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Submission deadline corresponding to standard office closing (typically 5:00 PM)."}]]}],["$","tr","3",{"className":"hover:bg-[#F7F7F5]/50 transition-colors","children":[["$","td","0",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"TBD / TBA"}],["$","td","1",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"To Be Decided / Announced"}],["$","td","2",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Parameters pending confirmation; used in scheduling and agendas."}]]}],["$","tr","4",{"className":"hover:bg-[#F7F7F5]/50 transition-colors","children":[["$","td","0",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"RSVP"}],["$","td","1",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Répondez s'il vous plaît"}],["$","td","2",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Formal request for attendance confirmation; requires immediate RSVP reply."}]]}]]}]]}],"$undefined"]}],"$undefined"]}]]}],["$","$L3",null,{"componentId":"email-annotator"}],["$","$L4",null,{"synthesis":{"topicMeaning":"Professional email and netiquette govern written digital correspondence across corporate and academic networks. It establishes rigorous standards for recipient curation (To/Cc/Bcc), scannable modular formatting, action-oriented subject lines, and respectful tone calibration, recognizing that every email represents a permanent organizational record.","coreConceptsLearned":["The 7 Anatomical Sections of an Executive Email: Recipient Curation (To/Cc/Bcc), High-Impact Subject Line, Role-Appropriate Salutation, Contextual Hook, Scannable Body, Explicit CTA & Deadline, and Signature Block.","Recipient Discipline: Judicious separation of direct action owners (To), informational awareness (Cc), and privacy protection (Bcc); absolute avoidance of accidental 'Reply All'.","The 7 Golden Rules of Netiquette: Explicit subject lines, no shouting (ALL CAPS), proofreading before send, professional email handle, attachment hygiene, 24h SLA response times, and tone calibration.","Corporate Netiquette Abbreviations: ASAP, FYI, COB/EOD, TBD/TBA, RSVP, and when to use them appropriately."],"whyItMattersInIT":"Software teams, open-source communities, and enterprise clients operate predominantly through asynchronous written communication. Vague subject lines, missing calls to action, careless 'Reply All' threads, or sloppy email hygiene cause project delays, create security liabilities, and erode executive confidence in technical teams.","activityConnections":[{"activityTitle":"Academic Communication with University Faculty & Lecturers In Charge","activityType":"Academic (SLIIT City Uni)","description":"Submitting assignment queries, project documentation drafts, and viva coordination emails to Senior Lecturer Mrs. Ishara Raviharee Weerasinghe and faculty instructors using proper salutations, contextual hooks, and professional signature blocks."},{"activityTitle":"Corporate Correspondence with Clients & Stakeholders","activityType":"Entrepreneurship (LA'CEDRA)","description":"Drafting technical proposals, service contract renewals, and project delivery follow-ups for LA'CEDRA, ensuring messages are structured with scannable bullet points and clear delivery deadlines."}],"practicalApplications":[{"scenario":"High-Impact Project Submission & Specification Transmittal","implementation":"Formatting subject lines with clear tags: `[Action Required] Software Engineering Architecture Proposal — Teran Rathnayake (SA25610122)` so recipients can instantly prioritize incoming emails."},{"scenario":"Handling High-Stakes Client Escalations Asynchronously","implementation":"Pausing before hitting send on critical client emails, calibrating tone to remain diplomatic, objective, and solution-focused while avoiding defensive emotional responses."}],"personalReflection":{"narrative":"The anatomical breakdown of an email transformed how I communicate with clients and university mentors. I used to write long, continuous paragraphs that buried the key request. Adopting scannable bullet points and an explicit 'Call to Action by Thursday at 4:00 PM' has visibly improved the speed and clarity of responses I receive.","editableInputPrompt":"[Editable Reflection Slot: Add your personal thoughts on an important email exchange with a lecturer, corporate client, or supplier that required careful netiquette.]"},"areasForImprovement":["Pruning initial pleasantries to respect busy recipients' time, stating the primary objective in the first two sentences.","Rigorously confirming that all referenced attachments are properly compressed, named professionally, and attached prior to drafting the email."],"keyTakeaways":["An email without an explicit Call to Action (CTA) and a deadline generates operational paralysis.","Every sent email is a permanent, archivable legal and professional record; write with precision and calibrated respect."]},"chapterNumber":"06","chapterTitle":"Professional Email & Online Etiquette"}],["$","div",null,{"className":"my-12 pt-8 border-t border-[#E5E5E2] space-y-6","children":[["$","div",null,{"className":"flex items-center space-x-2","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark w-4 h-4 text-[#FF6B35]","children":[["$","path","1fy3hk",{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"}],"$undefined"]}],["$","h3",null,{"className":"text-xs font-mono uppercase tracking-widest text-[#FF6B35] font-bold","children":"Core Academic Takeaways"}]]}],["$","div",null,{"className":"grid grid-cols-1 md:grid-cols-2 gap-6","children":[["$","div","0",{"className":"p-5 rounded-2xl bg-white border border-[#E5E5E2] flex items-start space-x-3 shadow-subtle hover:border-[#171717] transition-all","children":[["$","span",null,{"className":"font-mono text-xs font-bold text-[#FF6B35] shrink-0 mt-0.5","children":["0",1,"."]}],["$","p",null,{"className":"text-xs sm:text-sm text-[#171717] leading-relaxed font-sans","children":"Emails are formal business artefacts: separate 'To' (action owners) from 'Cc' (awareness) and avoid accidental 'Reply All'."}]]}],["$","div","1",{"className":"p-5 rounded-2xl bg-white border border-[#E5E5E2] flex items-start space-x-3 shadow-subtle hover:border-[#171717] transition-all","children":[["$","span",null,{"className":"font-mono text-xs font-bold text-[#FF6B35] shrink-0 mt-0.5","children":["0",2,"."]}],["$","p",null,{"className":"text-xs sm:text-sm text-[#171717] leading-relaxed font-sans","children":"Subject lines must be action-oriented; ALL CAPS is perceived as unprofessional digital shouting."}]]}],["$","div","2",{"className":"p-5 rounded-2xl bg-white border border-[#E5E5E2] flex items-start space-x-3 s