ded-full bg-[#FFF1EB] text-[#FF6B35] font-bold tracking-wider","children":["Module ","03"]}],["$","span",null,{"className":"text-xs font-mono uppercase text-[#171717] font-semibold","children":"Non-Verbal & Dialogue"}],["$","span",null,{"className":"text-[#8E8E93]","children":"•"}],["$","span",null,{"className":"flex items-center space-x-1.5 text-xs text-[#686868] font-mono","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-clock w-3.5 h-3.5 text-[#FF6B35]","children":[["$","circle","1mglay",{"cx":"12","cy":"12","r":"10"}],["$","polyline","68esgv",{"points":"12 6 12 12 16 14"}],"$undefined"]}],["$","span",null,{"children":["9 min read"," read"]}]]}]]}],["$","div",null,{"className":"space-y-2 relative z-10","children":[["$","h1",null,{"className":"text-4xl sm:text-5xl md:text-6xl font-display font-extrabold text-[#171717] tracking-tight leading-[1]","children":"Job Interviews & Mock Interview Skills"}],["$","p",null,{"className":"text-xl font-display font-medium text-[#404040] pt-1","children":"The Three Mandatory Questions, Mehrabian Non-Verbal Rule & STAR Method"}]]}],["$","div",null,{"className":"pt-4 flex flex-wrap items-center justify-between gap-4 text-xs font-mono border-t border-[#E5E5E2] relative z-10","children":[["$","div",null,{"className":"flex items-center space-x-3","children":[["$","span",null,{"className":"text-[#FF6B35] font-bold","children":"Academic Lead:"}],["$","span",null,{"className":"font-semibold text-[#171717]","children":"Mrs. Ishara Raviharee Weerasinghe"}],["$","span",null,{"className":"text-[#8E8E93]","children":["(","Senior Lecturer in English | Lecturer In Charge",")"]}]]}],["$","div",null,{"className":"text-[#8E8E93]","children":"SLIIT City Uni • Professional Skills Assessment Standard"}]]}]]}],["$","div",null,{"className":"p-8 md:p-10 rounded-3xl bg-white border border-[#E5E5E2] shadow-subtle space-y-6","children":[["$","div",null,{"children":[["$","span",null,{"className":"text-xs font-mono uppercase tracking-widest text-[#FF6B35] font-bold block mb-2","children":"Curriculum Overview & Context"}],["$","p",null,{"className":"text-base sm:text-lg text-[#171717] leading-relaxed font-sans font-medium","children":"Demystifies the interview room as a two-way evidence-gathering dialogue. Breaks down Mehrabian's 93% non-verbal communication rule, the 6 C's (+ Confident) evaluation framework, and the STAR behavioral answering methodology."}]]}],["$","div",null,{"className":"pt-6 border-t border-[#E5E5E2] space-y-3","children":[["$","div",null,{"className":"flex items-center space-x-2","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-graduation-cap w-4 h-4 text-[#FF6B35]","children":[["$","path","j76jl0",{"d":"M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"}],["$","path","1lu8f3",{"d":"M22 10v6"}],["$","path","1r8lef",{"d":"M6 12.5V16a6 3 0 0 0 12 0v-3.5"}],"$undefined"]}],["$","h4",null,{"className":"text-xs font-mono uppercase tracking-widest text-[#171717] font-bold","children":"Core Competencies & Learning Objectives"}]]}],["$","ul",null,{"className":"grid grid-cols-1 md:grid-cols-2 gap-3 text-xs sm:text-sm text-[#404040]","children":[["$","li","0",{"className":"flex items-start space-x-2.5 font-sans","children":[["$","span",null,{"className":"text-[#FF6B35] font-mono font-bold mt-0.5 shrink-0","children":"→"}],["$","span",null,{"children":"Master the three foundational questions underlying every interview question."}]]}],["$","li","1",{"className":"flex items-start space-x-2.5 font-sans","children":[["$","span",null,{"className":"text-[#FF6B35] font-mono font-bold mt-0.5 shrink-0","children":"→"}],["$","span",null,{"children":"Evaluate candidate performance using the 6 C's (+ Confident) framework."}]]}],["$","li","2",{"className":"flex items-start space-x-2.5 font-sans","children":[["$","span",null,{"className":"text-[#FF6B35] font-mono font-bold mt-0.5 shrink-0","children":"→"}],["$","span",null,{"children":"Internalize Mehrabian's 7-38-55 Communication Rule for high-stakes interviews."}]]}],["$","li","3",{"className":"flex items-start space-x-2.5 font-sans","children":[["$","span",null,{"className":"text-[#FF6B35] font-mono font-bold mt-0.5 shrink-0","children":"→"}],["$","span",null,{"children":"Structure behavioral responses using the STAR methodology (Situation, Task, Action, Result)."}]]}],["$","li","4",{"className":"flex items-start space-x-2.5 font-sans","children":[["$","span",null,{"className":"text-[#FF6B35] font-mono font-bold mt-0.5 shrink-0","children":"→"}],["$","span",null,{"children":"Employ precise grammatical tenses: Present for capabilities, Past for achievements, Future for vision."}]]}]]}]]}]]}],["$","div",null,{"className":"space-y-8","children":[["$","section",null,{"className":"py-8 border-b border-[#E5E5E2] space-y-6","children":[["$","div",null,{"className":"space-y-1","children":[["$","h2",null,{"className":"text-2xl sm:text-3xl font-display font-bold text-[#171717] tracking-tight","children":"The Three Mandatory Candidate Questions"}],["$","p",null,{"className":"text-sm font-mono text-[#FF6B35] font-semibold","children":"The Core Subtext of All Interview Inquiries"}]]}],["$","div",null,{"className":"space-y-4 max-w-3xl","children":[["$","p","0",{"className":"text-base text-[#404040] leading-relaxed font-sans","children":"An interview is not an interrogation; it is a high-stakes, two-way evidence-gathering professional dialogue. Regardless of how an interviewer phrases their questions, they are fundamentally probing three foundational truths."}]]}],["$","div",null,{"className":"space-y-3 pl-4 sm:pl-6 border-l-2 border-[#FF6B35]/40 my-6 max-w-3xl","children":[["$","div","0",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["1. Why are you here?",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Evaluates genuine motivation, institutional alignment, passion for the company's specific product ecosystem, and career narrative continuity."}]]}],["$","div","1",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["2. What can you do for us?",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Assesses concrete technical competency, return on investment (ROI), domain proficiency, and ability to eliminate technical roadblocks."}]]}],["$","div","2",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["3. What kind of person are you?",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Uncovers cultural fit, emotional resilience under stress, ethical courage, and collaborative demeanor within multidisciplinary teams."}]]}]]}],"$undefined","$undefined"]}],["$","section",null,{"className":"py-8 border-b border-[#E5E5E2] space-y-6","children":[["$","div",null,{"className":"space-y-1","children":[["$","h2",null,{"className":"text-2xl sm:text-3xl font-display font-bold text-[#171717] tracking-tight","children":"Mehrabian's Communication Rule (1971)"}],["$","p",null,{"className":"text-sm font-mono text-[#FF6B35] font-semibold","children":"The 93% Non-Verbal Dominance in Human Appraisal"}]]}],["$","div",null,{"className":"space-y-4 max-w-3xl","children":[["$","p","0",{"className":"text-base text-[#404040] leading-relaxed font-sans","children":"In 1971, Dr. Albert Mehrabian established that during face-to-face communication involving feelings and attitudes, literal words convey only a fraction of the total impression."}],["$","p","1",{"className":"text-base text-[#404040] leading-relaxed font-sans","children":"If a candidate's verbal statements are incongruent with their posture or vocal inflection, the hiring panel will unconsciously believe the non-verbal signals every single time."}]]}],"$undefined",["$","div",null,{"className":"my-8 overflow-x-auto rounded-2xl border border-[#E5E5E2] bg-white shadow-subtle","children":[["$","table",null,{"className":"w-full text-left text-xs md:text-sm border-collapse","children":[["$","thead",null,{"children":["$","tr",null,{"className":"bg-[#F7F7F5] border-b border-[#E5E5E2]","children":[["$","th","0",{"className":"py-3.5 px-4 font-mono font-semibold uppercase tracking-wider text-[#171717] text-[11px]","children":"Communication Layer"}],["$","th","1",{"className":"py-3.5 px-4 font-mono font-semibold uppercase tracking-wider text-[#171717] text-[11px]","children":"Percentage Impact"}],["$","th","2",{"className":"py-3.5 px-4 font-mono font-semibold uppercase tracking-wider text-[#171717] text-[11px]","children":"Interview Manifestation & Best Practice"}]]}]}],["$","tbody",null,{"className":"divide-y divide-[#E5E5E2] bg-white","children":[["$","tr","0",{"className":"hover:bg-[#F7F7F5]/50 transition-colors","children":[["$","td","0",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Body Language"}],["$","td","1",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"55%"}],["$","td","2",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Upright open posture, authentic eye contact, firm handshake, purposeful gestures, professional attire."}]]}],["$","tr","1",{"className":"hover:bg-[#F7F7F5]/50 transition-colors","children":[["$","td","0",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Tone of Voice"}],["$","td","1",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"38%"}],["$","td","2",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Warm resonance, moderate cadence, pitch modulation, eliminating uptalk and hesitant vocal fry."}]]}],["$","tr","2",{"className":"hover:bg-[#F7F7F5]/50 transition-colors","children":[["$","td","0",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Spoken Words"}],["$","td","1",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"7%"}],["$","td","2",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Concise technical vocabulary, precise terminology, absence of colloquial slang and filler sounds ('um', 'like')."}]]}]]}]]}],"$undefined"]}],"$undefined"]}],["$","section",null,{"className":"py-8 border-b border-[#E5E5E2] space-y-6","children":[["$","div",null,{"className":"space-y-1","children":[["$","h2",null,{"className":"text-2xl sm:text-3xl font-display font-bold text-[#171717] tracking-tight","children":"The STAR Behavioral Answering Methodology"}],["$","p",null,{"className":"text-sm font-mono text-[#FF6B35] font-semibold","children":"Engineering Quantifiable, High-Impact Evidence"}]]}],["$","div",null,{"className":"space-y-4 max-w-3xl","children":[["$","p","0",{"className":"text-base text-[#404040] leading-relaxed font-sans","children":"Top-tier tech corporations (Google, Amazon, Microsoft) utilize behavioral interviewing based on the psychological premise that past performance is the best predictor of future behavior."}],["$","p","1",{"className":"text-base text-[#404040] leading-relaxed font-sans","children":"The STAR formula guarantees that the candidate delivers structured, evidence-backed answers without meandering into superficial generalizations."}]]}],["$","div",null,{"className":"space-y-3 pl-4 sm:pl-6 border-l-2 border-[#FF6B35]/40 my-6 max-w-3xl","children":[["$","div","0",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["S - Situation",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Establish the specific organizational context, project background, or corporate crisis (15% of answer time)."}]]}],["$","div","1",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["T - Task",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Clarify the precise technical objective, deadline pressure, or explicit challenge you were assigned to solve (15% of answer time)."}]]}],["$","div","2",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["A - Action",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Articulate the exact technical and interpersonal initiatives YOU led. Focus on 'I' rather than a vague 'we' (50% of answer time)."}]]}],["$","div","3",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["R - Result",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Deliver quantifiable business or technical outcomes, metrics achieved, and lessons learned (20% of answer time)."}]]}]]}],"$undefined",["$","div",null,{"className":"my-8 p-6 sm:p-8 rounded-2xl bg-[#FFF1EB] border-l-4 border-l-[#FF6B35] relative","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-quote w-8 h-8 text-[#FF6B35]/25 absolute top-5 right-5","children":[["$","path","rib7q0",{"d":"M16 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"}],["$","path","1ymkrd",{"d":"M5 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"}],"$undefined"]}],["$","span",null,{"className":"text-xs font-mono uppercase tracking-wider text-[#FF6B35] font-bold block mb-2","children":"Grammatical Tense Precision"}],["$","blockquote",null,{"className":"text-base sm:text-lg font-serif italic text-[#171717] leading-relaxed max-w-2xl","children":["“","Use Present Tense for current capabilities ('I am proficient in TypeScript'); Past Simple / Present Perfect for completed achievements ('I engineered the database schema'); Future Tense for organizational vision ('I will optimize your query latency').","”"]}],["$","div",null,{"className":"text-xs font-mono text-[#686868] mt-3","children":["— ","Interview Communication Protocol"]}]]}]]}]]}],["$","$L3",null,{"componentId":"star-builder"}],["$","$L4",null,{"synthesis":{"topicMeaning":"A professional job interview is a high-stakes, structured two-way evidence-gathering dialogue where hiring evaluators assess organizational cultural alignment, emotional composure, and concrete problem-solving capability. Success depends on mastering structured answering methodologies (STAR) and synchronizing verbal lexical precision with authoritative non-verbal communication.","coreConceptsLearned":["The Three Mandatory Candidate Inquiries: 'Why are you here?' (passion), 'What can you do for us?' (hard competency & ROI), 'What kind of person are you?' (culture fit & emotional stability).","The 6 C's (+ Confident) Evaluation Framework: Clear, Concise, Concrete, Correct, Coherent, Courteous, and Confident.","Mehrabian's Communication Rule (1971): 55% Body Language (posture, eye contact), 38% Tone of Voice (pitch, inflection), 7% Spoken Words.","STAR Behavioral Answering Methodology: Situation (context), Task (objective/blocker), Action (specific technical/interpersonal execution), Result (quantifiable impact & lessons).","Grammatical Precision: Present Tense for ongoing habits, Past Simple for completed accomplishments, Future forms for strategic career goals."],"whyItMattersInIT":"Technical candidates frequently fail interviews not because they lack coding proficiency, but because they ramble incoherently, fail to articulate their problem-solving thought processes, or project nervous defensiveness. In agile engineering teams, communicating why an architectural trade-off was made under pressure is just as critical as writing the code.","activityConnections":[{"activityTitle":"Preparing for Software Engineering & Internship Opportunities","activityType":"Academic (SLIIT City Uni)","description":"Applying the STAR framework to structure technical anecdotes from my HDIT academic assignments and software development activities, ensuring answers highlight specific architectural contributions and measurable outcomes."},{"activityTitle":"Pitching Technical Solutions & Negotiating with Business Clients","activityType":"Entrepreneurship (LA'CEDRA)","description":"Treating client discovery meetings and technical consultations for LA'CEDRA as professional dialogues where vocal poise, authentic eye contact, and concrete value propositions determine commercial trust."}],"practicalApplications":[{"scenario":"Behavioral & Technical Architecture Interview Questions","implementation":"Deconstructing complex debugging experiences (e.g. troubleshooting Apache virtual hosts and MySQL on a DigitalOcean VPS) using Situation, Task, Action, and Result without rambling."},{"scenario":"Executive Non-Verbal Poise during High-Stakes Syncs","implementation":"Aligning body language (upright open posture, authentic eye contact) and warm vocal pitch (38%) to convey composed confidence during technical demonstrations."}],"personalReflection":{"narrative":"Learning Mehrabian's model was an eye-opener. I previously believed that technical interviews were won almost entirely by lexical accuracy—the 7% spoken words. Practicing recorded mock interviews revealed that my vocal inflection and physical posture dramatically influenced how confident and credible my technical explanations sounded to listeners.","editableInputPrompt":"[Editable Reflection Slot: Add your personal thoughts on a mock interview drill, oral viva presentation, or client negotiation session you experienced.]"},"areasForImprovement":["Pacing my speaking cadence under time pressure to eliminate vocal fillers ('um', 'like', 'you know').","Ensuring that the 'Result' phase of my STAR anecdotes always includes concrete, quantifiable metrics and key pedagogical takeaways."],"keyTakeaways":["Interviewers remember structured storytelling; the STAR method anchors technical explanations in concrete real-world evidence.","Non-verbal posture and vocal warmth account for 93% of perceived credibility; master your composure before uttering a word."]},"chapterNumber":"03","chapterTitle":"Job Interviews & Mock Interview Skills"}],["$","div",null,{"className":"my-12 pt-8 border-t border-[#E5E5E2] space-y-6","children":[["$","div",null,{"className":"flex items-center space-x-2","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark w-4 h-4 text-[#FF6B35]","children":[["$","path","1fy3hk",{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"}],"$undefined"]}],["$","h3",null,{"className":"text-xs font-mono uppercase tracking-widest text-[#FF6B35] font-bold","children":"Core Academic Takeaways"}]]}],["$","div",null,{"className":"grid grid-cols-1 md:grid-cols-2 gap-6","children":[["$","div","0",{"className":"p-5 rounded-2xl bg-white border border-[#E5E5E2] flex items-start space-x-3 shadow-subtle hover:border-[#171717] transition-all","children":[["$","span",null,{"className":"font-mono text-xs font-bold text-[#FF6B35] shrink-0 mt-0.5","children":["0",1,"."]}],["$","p",null,{"className":"text-xs sm:text-sm text-[#171717] leading-relaxed font-sans","children":"93% of an interview impression is non-verbal (55% body language + 38% vocal tone); words comprise only 7%."}]]}],["$","div","1",{"className":"p-5 rounded-2xl bg-white border border-[#E5E5E2] flex items-start space-x-3 shadow-subtle hover:border-[#171717] transition-all","children":[["$","span",null,{"className":"font-mono text-xs font-bold text-[#FF6B35] shrink-0 mt-0.5","children":["0",2,"."]}],["$","p",null,{"className":"text-xs sm:text-sm text-[#171717] leading-relaxed font-sans","children":"Every question is a disguised variant of: Why are you here? What can you do for us? What kind of person are you?"}]]}],["$","div","2",{"className":"p-5 rounded-2xl bg-white border border-[#E5E5E2] flex items-start space-x-3 shadow-subtle hover:border-[#171717] transition-all","children":[["$","span",null,{"className":"font-mono text-xs font-bold text-[#FF6B35] shrink-0 mt-0.5","children":["0",3,"."]}],["$","p",null,{"className":"text-xs sm:text-sm text-[#171717] leading-relaxed font-sans","children":"The STAR method (Situation, Task, Action, Result) ensures candidate answers are concise, evidence-driven, and quantifiable."}]]}],["$","div","3",{"className":"p-5 rounded-2xl bg-white border border-[#E5E5E2] flex items-start space-x-3 shadow-subtle hover:border-[#171717] transition-all","children":[["$","span",null,{"className":"font-mono text-xs font-bold text-[#FF6B35] shrink-0 mt-0.5","children":["0",4,"."]}],["$","p",null,{"className":"text-xs sm:text-sm text-[#171717] leading-relaxed font-sans","children":"Successful candidates research company specifics and exhibit the 6 C's (+ Confident); unsuccessful candidates exhibit generic answers and fidgeting."}]]}]]}]]}],["$","div",null,{"className":"space-y-6 pt-8 border-t border-[#E5E5E2]