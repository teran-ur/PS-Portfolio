1 rounded-full bg-[#FFF1EB] text-[#FF6B35] font-bold tracking-wider","children":["Module ","08"]}],["$","span",null,{"className":"text-xs font-mono uppercase text-[#171717] font-semibold","children":"Neuroscience & EQ"}],["$","span",null,{"className":"text-[#8E8E93]","children":"•"}],["$","span",null,{"className":"flex items-center space-x-1.5 text-xs text-[#686868] font-mono","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-clock w-3.5 h-3.5 text-[#FF6B35]","children":[["$","circle","1mglay",{"cx":"12","cy":"12","r":"10"}],["$","polyline","68esgv",{"points":"12 6 12 12 16 14"}],"$undefined"]}],["$","span",null,{"children":["9 min read"," read"]}]]}]]}],["$","div",null,{"className":"space-y-2 relative z-10","children":[["$","h1",null,{"className":"text-4xl sm:text-5xl md:text-6xl font-display font-extrabold text-[#171717] tracking-tight leading-[1]","children":"Emotional Intelligence & Brain Dynamics"}],["$","p",null,{"className":"text-xl font-display font-medium text-[#404040] pt-1","children":"The Triune Brain Model, The Amygdala Hijack & EQ vs. IQ in Tech Leadership"}]]}],["$","div",null,{"className":"pt-4 flex flex-wrap items-center justify-between gap-4 text-xs font-mono border-t border-[#E5E5E2] relative z-10","children":[["$","div",null,{"className":"flex items-center space-x-3","children":[["$","span",null,{"className":"text-[#FF6B35] font-bold","children":"Academic Lead:"}],["$","span",null,{"className":"font-semibold text-[#171717]","children":"Mrs. Ishara Raviharee Weerasinghe"}],["$","span",null,{"className":"text-[#8E8E93]","children":["(","Senior Lecturer in English | Lecturer In Charge",")"]}]]}],["$","div",null,{"className":"text-[#8E8E93]","children":"SLIIT City Uni • Professional Skills Assessment Standard"}]]}]]}],["$","div",null,{"className":"p-8 md:p-10 rounded-3xl bg-white border border-[#E5E5E2] shadow-subtle space-y-6","children":[["$","div",null,{"children":[["$","span",null,{"className":"text-xs font-mono uppercase tracking-widest text-[#FF6B35] font-bold block mb-2","children":"Curriculum Overview & Context"}],["$","p",null,{"className":"text-base sm:text-lg text-[#171717] leading-relaxed font-sans font-medium","children":"Grounds emotional intelligence in evolutionary neuroscience. Analyzes Paul MacLean's Triune Brain Model, Daniel Goleman's Amygdala Hijack mechanism, Paul Ekman's 6 universal emotions, and the comparative value of EQ over IQ."}]]}],["$","div",null,{"className":"pt-6 border-t border-[#E5E5E2] space-y-3","children":[["$","div",null,{"className":"flex items-center space-x-2","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-graduation-cap w-4 h-4 text-[#FF6B35]","children":[["$","path","j76jl0",{"d":"M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"}],["$","path","1lu8f3",{"d":"M22 10v6"}],["$","path","1r8lef",{"d":"M6 12.5V16a6 3 0 0 0 12 0v-3.5"}],"$undefined"]}],["$","h4",null,{"className":"text-xs font-mono uppercase tracking-widest text-[#171717] font-bold","children":"Core Competencies & Learning Objectives"}]]}],["$","ul",null,{"className":"grid grid-cols-1 md:grid-cols-2 gap-3 text-xs sm:text-sm text-[#404040]","children":[["$","li","0",{"className":"flex items-start space-x-2.5 font-sans","children":[["$","span",null,{"className":"text-[#FF6B35] font-mono font-bold mt-0.5 shrink-0","children":"→"}],["$","span",null,{"children":"Understand the three evolutionary layers of Paul MacLean's Triune Brain Model."}]]}],["$","li","1",{"className":"flex items-start space-x-2.5 font-sans","children":[["$","span",null,{"className":"text-[#FF6B35] font-mono font-bold mt-0.5 shrink-0","children":"→"}],["$","span",null,{"children":"Identify the neurobiological mechanism of the Amygdala Hijack and apply the 6-to-10 second respiration pause."}]]}],["$","li","2",{"className":"flex items-start space-x-2.5 font-sans","children":[["$","span",null,{"className":"text-[#FF6B35] font-mono font-bold mt-0.5 shrink-0","children":"→"}],["$","span",null,{"children":"Recognize Paul Ekman's 6 hard-wired universal human emotions."}]]}],["$","li","3",{"className":"flex items-start space-x-2.5 font-sans","children":[["$","span",null,{"className":"text-[#FF6B35] font-mono font-bold mt-0.5 shrink-0","children":"→"}],["$","span",null,{"children":"Contrast Emotional Quotient (EQ) and Intelligence Quotient (IQ) in career advancement."}]]}],["$","li","4",{"className":"flex items-start space-x-2.5 font-sans","children":[["$","span",null,{"className":"text-[#FF6B35] font-mono font-bold mt-0.5 shrink-0","children":"→"}],["$","span",null,{"children":"Develop the 4 core domains of EQ: Self-Awareness, Self-Management, Social Awareness, and Relationship Management."}]]}]]}]]}]]}],["$","div",null,{"className":"space-y-8","children":[["$","section",null,{"className":"py-8 border-b border-[#E5E5E2] space-y-6","children":[["$","div",null,{"className":"space-y-1","children":[["$","h2",null,{"className":"text-2xl sm:text-3xl font-display font-bold text-[#171717] tracking-tight","children":"Neuroscience Foundation: The Triune Brain Model"}],["$","p",null,{"className":"text-sm font-mono text-[#FF6B35] font-semibold","children":"The Three Evolutionary Strata of Human Cognition"}]]}],["$","div",null,{"className":"space-y-4 max-w-3xl","children":[["$","p","0",{"className":"text-base text-[#404040] leading-relaxed font-sans","children":"Developed by neuroscientist Paul MacLean, the Triune Brain Model conceptualizes the human brain as three distinct, evolutionarily layered systems that cooperate (and frequently clash) under pressure."}]]}],["$","div",null,{"className":"space-y-3 pl-4 sm:pl-6 border-l-2 border-[#FF6B35]/40 my-6 max-w-3xl","children":[["$","div","0",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["1. Reptilian Complex (Brainstem & Cerebellum)",":"]}],["$","span",null,{"className":"text-[#555555]","children":"The oldest evolutionary layer (~500 million years old). Controls autonomic physical functions (heart rate, breathing) and instinctual survival drives: fight, flight, or freeze."}]]}],["$","div","1",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["2. Limbic System (Mammalian Brain — Amygdala & Hippocampus)",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Evolved in early mammals (~150 million years old). The seat of emotions, social bonding, memory encoding, and rapid threat appraisal. Prioritizes immediate emotional survival over logic."}]]}],["$","div","2",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["3. Neocortex (Prefrontal Cortex — 'The CEO')",":"]}],["$","span",null,{"className":"text-[#555555]","children":"The newest evolutionary development. Responsible for rational logic, abstract deduction, architectural planning, impulse inhibition, and ethical decision-making."}]]}]]}],"$undefined","$undefined"]}],["$","section",null,{"className":"py-8 border-b border-[#E5E5E2] space-y-6","children":[["$","div",null,{"className":"space-y-1","children":[["$","h2",null,{"className":"text-2xl sm:text-3xl font-display font-bold text-[#171717] tracking-tight","children":"The Amygdala Hijack Mechanism (Goleman, 1995)"}],["$","p",null,{"className":"text-sm font-mono text-[#FF6B35] font-semibold","children":"How Stress Short-Circuits Executive Function"}]]}],["$","div",null,{"className":"space-y-4 max-w-3xl","children":[["$","p","0",{"className":"text-base text-[#404040] leading-relaxed font-sans","children":"When sensory input enters the brain via the thalamus, it splits into two pathways: a slow, high-resolution route to the Neocortex for rational processing, and a high-speed emergency shortcut to the Amygdala."}],["$","p","1",{"className":"text-base text-[#404040] leading-relaxed font-sans","children":"When emotional stimuli are perceived as threats (e.g., severe critical feedback from a tech lead), the amygdala triggers an immediate flood of adrenaline and cortisol before the prefrontal cortex can process the data."}],["$","p","2",{"className":"text-base text-[#404040] leading-relaxed font-sans","children":"This causes an 'Amygdala Hijack'—irrational outbursts, defensive panic, or cognitive shutdown."}]]}],"$undefined","$undefined",["$","div",null,{"className":"my-8 p-6 sm:p-8 rounded-2xl bg-[#FFF1EB] border-l-4 border-l-[#FF6B35] relative","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-quote w-8 h-8 text-[#FF6B35]/25 absolute top-5 right-5","children":[["$","path","rib7q0",{"d":"M16 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"}],["$","path","1ymkrd",{"d":"M5 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"}],"$undefined"]}],["$","span",null,{"className":"text-xs font-mono uppercase tracking-wider text-[#FF6B35] font-bold block mb-2","children":"The 6-to-10 Second Respiration Protocol"}],["$","blockquote",null,{"className":"text-base sm:text-lg font-serif italic text-[#171717] leading-relaxed max-w-2xl","children":["“","Neurological research demonstrates that an amygdala hormonal surge lasts between 6 and 10 seconds. Taking slow, deep diaphragmatic breaths during this critical window replenishes prefrontal oxygenation, allowing the rational 'CEO' to regain command before you speak or act.","”"]}],["$","div",null,{"className":"text-xs font-mono text-[#686868] mt-3","children":["— ","Daniel Goleman"]}]]}]]}],["$","section",null,{"className":"py-8 border-b border-[#E5E5E2] space-y-6","children":[["$","div",null,{"className":"space-y-1","children":[["$","h2",null,{"className":"text-2xl sm:text-3xl font-display font-bold text-[#171717] tracking-tight","children":"Paul Ekman's 6 Universal Emotions & EQ vs. IQ"}],["$","p",null,{"className":"text-sm font-mono text-[#FF6B35] font-semibold","children":"Hard-Wired Biology and Workplace Performance"}]]}],["$","div",null,{"className":"space-y-4 max-w-3xl","children":[["$","p","0",{"className":"text-base text-[#404040] leading-relaxed font-sans","children":"Psychologist Paul Ekman demonstrated across diverse global cultures that all human beings share six primary, biologically hard-wired emotions: Joy, Anger, Disgust, Fear, Sadness, and Surprise."}],["$","p","1",{"className":"text-base text-[#404040] leading-relaxed font-sans","children":"In the knowledge workplace, IQ gets an engineer hired for technical skills, but EQ determines whether they can lead teams, resolve conflicts, withstand sprint pressure, and earn executive trust."}]]}],"$undefined",["$","div",null,{"className":"my-8 overflow-x-auto rounded-2xl border border-[#E5E5E2] bg-white shadow-subtle","children":[["$","table",null,{"className":"w-full text-left text-xs md:text-sm border-collapse","children":[["$","thead",null,{"children":["$","tr",null,{"className":"bg-[#F7F7F5] border-b border-[#E5E5E2]","children":[["$","th","0",{"className":"py-3.5 px-4 font-mono font-semibold uppercase tracking-wider text-[#171717] text-[11px]","children":"Attribute"}],["$","th","1",{"className":"py-3.5 px-4 font-mono font-semibold uppercase tracking-wider text-[#171717] text-[11px]","children":"Emotional Intelligence (EQ)"}],["$","th","2",{"className":"py-3.5 px-4 font-mono font-semibold uppercase tracking-wider text-[#171717] text-[11px]","children":"Intelligence Quotient (IQ)"}]]}]}],["$","tbody",null,{"className":"divide-y divide-[#E5E5E2] bg-white","children":[["$","tr","0",{"className":"hover:bg-[#F7F7F5]/50 transition-colors","children":[["$","td","0",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Cognitive Focus"}],["$","td","1",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Understanding, regulating, and harnessing emotions effectively."}],["$","td","2",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Logical reasoning, mathematical ability, and abstract spatial retention."}]]}],["$","tr","1",{"className":"hover:bg-[#F7F7F5]/50 transition-colors","children":[["$","td","0",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Plasticity Over Lifetime"}],["$","td","1",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Dynamically expandable throughout life through deliberate practice."}],["$","td","2",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Relatively static after late adolescence and early adulthood."}]]}],["$","tr","2",{"className":"hover:bg-[#F7F7F5]/50 transition-colors","children":[["$","td","0",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Workplace Predictor"}],["$","td","1",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Predicts leadership trajectory, stress resilience, and team cohesion."}],["$","td","2",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Predicts baseline technical comprehension and raw coding speed."}]]}],["$","tr","3",{"className":"hover:bg-[#F7F7F5]/50 transition-colors","children":[["$","td","0",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Crisis Performance"}],["$","td","1",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Enables calm de-escalation, empathy, and psychological safety."}],["$","td","2",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Can break down into defensive paralysis during emotional conflict."}]]}]]}]]}],"$undefined"]}],"$undefined"]}]]}],["$","$L3",null,{"componentId":"triune-brain"}],["$","$L4",null,{"synthesis":{"topicMeaning":"Emotional Intelligence (EQ) is the capacity to recognize, understand, regulate, and harness emotions in oneself and in interactions with others. Grounded in evolutionary neuroscience (Paul MacLean's Triune Brain Model) and cognitive psychology (Daniel Goleman), it explains how emotional stimuli can trigger an 'Amygdala Hijack' and provides physiological strategies to restore prefrontal executive control.","coreConceptsLearned":["The Triune Brain Model (Paul MacLean): Reptilian Complex (autonomic survival instincts), Limbic System (mammalian emotional seat / amygdala), and Neocortex (human rational CEO / prefrontal logic).","The Amygdala Hijack Mechanism (Daniel Goleman): When high-stress stimuli bypass rational prefrontal processing, triggering immediate defensive aggression or panic.","The 6-to-10 Second Respiration Interruption: Conscious deep breathing recalibrates physiological oxygenation, allowing the prefrontal cortex to re-engage cognitive command.","The 4 Core Domains of Emotional Intelligence: Self-Awareness (emotional radar), Self-Management (self-control & adaptability), Social Awareness (organizational empathy), and Relationship Management (constructive mediation).","Comparative Dynamics: IQ predicts baseline technical learning and logic; EQ determines leadership trajectory, collaborative durability, and stress tolerance.","Paul Ekman's 6 Hard-Wired Universal Emotions: Joy, Anger, Disgust, Fear, Sadness, and Surprise."],"whyItMattersInIT":"Software development environments are high-stress pressure cookers characterized by critical production outages, unforgiving deployment deadlines, and contentious code disputes. An engineer who succumbs to amygdala hijacks becomes toxic, defensive, and resistant to constructive feedback, creating team burnout and technical debt.","activityConnections":[{"activityTitle":"Managing Stress during University Assignment Sprints & Server Debugging","activityType":"Academic (SLIIT City Uni)","description":"Applying the 6-to-10 second respiration pause when encountering critical compilation or server errors (e.g. troubleshooting Apache virtual hosts and MySQL on DigitalOcean) during tight academic submission deadlines at SLIIT City Uni."},{"activityTitle":"Mediating Co-Founder & Partner Disagreements at LA'CEDRA","activityType":"Entrepreneurship (LA'CEDRA)","description":"Navigating commercial disagreements regarding resource allocation, technical architecture, and feature prioritization by exercising emotional self-regulation and empathetic active listening rather than reactive defensiveness."}],"practicalApplications":[{"scenario":"Handling Critical Software Code Reviews or Architectural Disagreements","implementation":"Recognizing physiological fight-or-flight triggers (racing pulse, shallow breathing) when code is challenged; taking three deep diaphragmatic breaths to re-engage the prefrontal cortex before responding constructively."},{"scenario":"Navigating High-Pressure Deployment Setbacks at LA'CEDRA","implementation":"Maintaining calm executive composure when faced with unexpected build errors or tight delivery deadlines, focusing on systematic analytical debugging rather than venting frustration on team members."}],"personalReflection":{"narrative":"Understanding the neurobiology of the Amygdala Hijack fundamentally changed my self-awareness. Previously, when high-stakes technical problems broke down at the last minute, I felt an immediate surge of defensive frustration. Learning that this is a primitive physiological response that can be interrupted by a simple 6-to-10 second breathing pause gave me an invaluable tool to stay calm, focused, and analytical under pressure.","editableInputPrompt":"[Editable Reflection Slot: Add your personal thoughts on a high-pressure project situation or team disagreement where conscious self-regulation helped you maintain control.]"},"areasForImprovement":["Catching early physiological warning signs of stress (jaw clenching, shallow breathing) earlier in the escalation cycle.","Deepening empathetic awareness of cross-functional team members who may be feeling overwhelmed by technical complexity."],"keyTakeaways":["An Amygdala Hijack is a physiological impulse, but reacting defensively is an executive choice; breathe for 6–10 seconds to restore rational command.","IQ gets an engineer hired for technical capability, but EQ determines whether they can lead teams, mediate disputes, and endure corporate crises."]},"chapterNumber":"08","chapterTitle":"Emotional Intelligence & Brain Dynamics"}],["$","div",null,{"className":"my-12 pt-8 border-t border-[#E5E5E2] space-y-6","children":[["$","div",null,{"className":"flex items-center space-x-2","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark w-4 h-4 text-[#FF6B35]","children":[["$","path","1fy3hk",{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"}],"$undefined"]}],["$","h3",null,{"className":"text-xs font-mono uppercase tracking-widest text-[#FF6B35] font-bold","children":"Core Academic Takeaways"}]]}],["$","div",null,{"className":"grid grid-cols-1 md:grid-cols-2 gap-6","children":[["$","div","0",{"className":"p-5 round