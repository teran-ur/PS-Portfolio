-3 py-1 rounded-full bg-[#FFF1EB] text-[#FF6B35] font-bold tracking-wider","children":["Module ","09"]}],["$","span",null,{"className":"text-xs font-mono uppercase text-[#171717] font-semibold","children":"Executive Protocol"}],["$","span",null,{"className":"text-[#8E8E93]","children":"•"}],["$","span",null,{"className":"flex items-center space-x-1.5 text-xs text-[#686868] font-mono","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-clock w-3.5 h-3.5 text-[#FF6B35]","children":[["$","circle","1mglay",{"cx":"12","cy":"12","r":"10"}],["$","polyline","68esgv",{"points":"12 6 12 12 16 14"}],"$undefined"]}],["$","span",null,{"children":["8 min read"," read"]}]]}]]}],["$","div",null,{"className":"space-y-2 relative z-10","children":[["$","h1",null,{"className":"text-4xl sm:text-5xl md:text-6xl font-display font-extrabold text-[#171717] tracking-tight leading-[1]","children":"Dining Etiquette & Table Manners"}],["$","p",null,{"className":"text-xl font-display font-medium text-[#404040] pt-1","children":"Formal Table Geography, Cutlery Signaling Codes & Continental vs. American Styles"}]]}],["$","div",null,{"className":"pt-4 flex flex-wrap items-center justify-between gap-4 text-xs font-mono border-t border-[#E5E5E2] relative z-10","children":[["$","div",null,{"className":"flex items-center space-x-3","children":[["$","span",null,{"className":"text-[#FF6B35] font-bold","children":"Academic Lead:"}],["$","span",null,{"className":"font-semibold text-[#171717]","children":"Mrs. Ishara Raviharee Weerasinghe"}],["$","span",null,{"className":"text-[#8E8E93]","children":["(","Senior Lecturer in English | Lecturer In Charge",")"]}]]}],["$","div",null,{"className":"text-[#8E8E93]","children":"SLIIT City Uni • Professional Skills Assessment Standard"}]]}]]}],["$","div",null,{"className":"p-8 md:p-10 rounded-3xl bg-white border border-[#E5E5E2] shadow-subtle space-y-6","children":[["$","div",null,{"children":[["$","span",null,{"className":"text-xs font-mono uppercase tracking-widest text-[#FF6B35] font-bold block mb-2","children":"Curriculum Overview & Context"}],["$","p",null,{"className":"text-base sm:text-lg text-[#171717] leading-relaxed font-sans font-medium","children":"Unpacks executive formal dining protocols for business dinners and diplomatic banquets. Details the 'Outside-In' silverware rule, the 'b' and 'd' spatial trick, Continental vs. American styles, silent utensil signals, and social taboos."}]]}],["$","div",null,{"className":"pt-6 border-t border-[#E5E5E2] space-y-3","children":[["$","div",null,{"className":"flex items-center space-x-2","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-graduation-cap w-4 h-4 text-[#FF6B35]","children":[["$","path","j76jl0",{"d":"M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"}],["$","path","1lu8f3",{"d":"M22 10v6"}],["$","path","1r8lef",{"d":"M6 12.5V16a6 3 0 0 0 12 0v-3.5"}],"$undefined"]}],["$","h4",null,{"className":"text-xs font-mono uppercase tracking-widest text-[#171717] font-bold","children":"Core Competencies & Learning Objectives"}]]}],["$","ul",null,{"className":"grid grid-cols-1 md:grid-cols-2 gap-3 text-xs sm:text-sm text-[#404040]","children":[["$","li","0",{"className":"flex items-start space-x-2.5 font-sans","children":[["$","span",null,{"className":"text-[#FF6B35] font-mono font-bold mt-0.5 shrink-0","children":"→"}],["$","span",null,{"children":"Master the architectural geography of a formal multi-course table setting."}]]}],["$","li","1",{"className":"flex items-start space-x-2.5 font-sans","children":[["$","span",null,{"className":"text-[#FF6B35] font-mono font-bold mt-0.5 shrink-0","children":"→"}],["$","span",null,{"children":"Apply the 'Outside-In' cutlery progression rule and the 'b' and 'd' spatial mnemonic."}]]}],["$","li","2",{"className":"flex items-start space-x-2.5 font-sans","children":[["$","span",null,{"className":"text-[#FF6B35] font-mono font-bold mt-0.5 shrink-0","children":"→"}],["$","span",null,{"children":"Contrast the Continental / European dining style with the American Zig-Zag style."}]]}],["$","li","3",{"className":"flex items-start space-x-2.5 font-sans","children":[["$","span",null,{"className":"text-[#FF6B35] font-mono font-bold mt-0.5 shrink-0","children":"→"}],["$","span",null,{"children":"Communicate silently with banquet service staff using universal resting and finished utensil codes."}]]}],["$","li","4",{"className":"flex items-start space-x-2.5 font-sans","children":[["$","span",null,{"className":"text-[#FF6B35] font-mono font-bold mt-0.5 shrink-0","children":"→"}],["$","span",null,{"children":"Identify high-risk executive social taboos: dropped silverware, toothpick usage, and digital devices."}]]}]]}]]}]]}],["$","div",null,{"className":"space-y-8","children":[["$","section",null,{"className":"py-8 border-b border-[#E5E5E2] space-y-6","children":[["$","div",null,{"className":"space-y-1","children":[["$","h2",null,{"className":"text-2xl sm:text-3xl font-display font-bold text-[#171717] tracking-tight","children":"The Architectural Geography of the Formal Table Setting"}],["$","p",null,{"className":"text-sm font-mono text-[#FF6B35] font-semibold","children":"Deciphering the Multi-Course Place Setting"}]]}],["$","div",null,{"className":"space-y-4 max-w-3xl","children":[["$","p","0",{"className":"text-base text-[#404040] leading-relaxed font-sans","children":"High-level business contracts, executive hiring decisions, and diplomatic alliances are frequently sealed over formal corporate dinners. Dining etiquette is not mere elitism; it is a universal signifier of discipline, mindfulness, and social poise."}]]}],["$","div",null,{"className":"space-y-3 pl-4 sm:pl-6 border-l-2 border-[#FF6B35]/40 my-6 max-w-3xl","children":[["$","div","0",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["The 'Outside-In' Silverware Rule",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Utensils are arranged in the exact order of meal service. Begin each course using the outermost silverware (salad fork/soup spoon) and progress inward toward the main plate."}]]}],["$","div","1",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["The 'b' and 'd' Spatial Finger Mnemonic",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Make circular loops by touching index fingers to thumbs on both hands under the table: the left hand forms the letter 'b' (Bread plate is on your left), while the right hand forms the letter 'd' (Drink glasses are on your right)."}]]}],["$","div","2",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["Cutlery Placement Geography",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Forks are placed strictly on the left of the dinner plate; knives (with cutting blades turned facing inward toward the plate) and spoons are placed on the right. Dessert silver rests horizontally above the plate."}]]}]]}],"$undefined","$undefined"]}],["$","section",null,{"className":"py-8 border-b border-[#E5E5E2] space-y-6","children":[["$","div",null,{"className":"space-y-1","children":[["$","h2",null,{"className":"text-2xl sm:text-3xl font-display font-bold text-[#171717] tracking-tight","children":"International Dining Styles: Continental vs. American"}],["$","p",null,{"className":"text-sm font-mono text-[#FF6B35] font-semibold","children":"Elegance and Efficiency at the Table"}]]}],["$","div",null,{"className":"space-y-4 max-w-3xl","children":[["$","p","0",{"className":"text-base text-[#404040] leading-relaxed font-sans","children":"Two primary dining styles dominate global corporate settings. In international business, the Continental method is widely preferred for its continuous elegance and efficiency."}]]}],"$undefined",["$","div",null,{"className":"my-8 overflow-x-auto rounded-2xl border border-[#E5E5E2] bg-white shadow-subtle","children":[["$","table",null,{"className":"w-full text-left text-xs md:text-sm border-collapse","children":[["$","thead",null,{"children":["$","tr",null,{"className":"bg-[#F7F7F5] border-b border-[#E5E5E2]","children":[["$","th","0",{"className":"py-3.5 px-4 font-mono font-semibold uppercase tracking-wider text-[#171717] text-[11px]","children":"Dining Style"}],["$","th","1",{"className":"py-3.5 px-4 font-mono font-semibold uppercase tracking-wider text-[#171717] text-[11px]","children":"Cutlery Mechanics"}],["$","th","2",{"className":"py-3.5 px-4 font-mono font-semibold uppercase tracking-wider text-[#171717] text-[11px]","children":"Hand Switching"}],["$","th","3",{"className":"py-3.5 px-4 font-mono font-semibold uppercase tracking-wider text-[#171717] text-[11px]","children":"Efficiency & Formality Rating"}]]}]}],["$","tbody",null,{"className":"divide-y divide-[#E5E5E2] bg-white","children":[["$","tr","0",{"className":"hover:bg-[#F7F7F5]/50 transition-colors","children":[["$","td","0",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Continental / European Style (Recommended)"}],["$","td","1",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Fork held continuously in left hand (tines pointed downward), knife in right hand. Food conveyed directly to mouth without switching."}],["$","td","2",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Zero hand switching; highly efficient, elegant, and recommended for measured conversation."}],["$","td","3",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"International Gold Standard for executive and diplomatic dining."}]]}],["$","tr","1",{"className":"hover:bg-[#F7F7F5]/50 transition-colors","children":[["$","td","0",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"American 'Zig-Zag' Style"}],["$","td","1",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Knife held in right hand to cut food while fork holds item with left hand. Knife rested on plate edge, fork transferred to right hand (tines upward) to eat."}],["$","td","2",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Constant hand switching between cutting and eating."}],["$","td","3",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Standard in domestic US dining; slower and more segmented."}]]}]]}]]}],"$undefined"]}],"$undefined"]}],["$","section",null,{"className":"py-8 border-b border-[#E5E5E2] space-y-6","children":[["$","div",null,{"className":"space-y-1","children":[["$","h2",null,{"className":"text-2xl sm:text-3xl font-display font-bold text-[#171717] tracking-tight","children":"Utensil Signaling Codes & Executive Taboos"}],["$","p",null,{"className":"text-sm font-mono text-[#FF6B35] font-semibold","children":"Silent Communication with Banquet Service Staff"}]]}],["$","div",null,{"className":"space-y-4 max-w-3xl","children":[["$","p","0",{"className":"text-base text-[#404040] leading-relaxed font-sans","children":"In formal banquets, servers are trained to read cutlery placement without speaking to or interrupting diners."}]]}],["$","div",null,{"className":"space-y-3 pl-4 sm:pl-6 border-l-2 border-[#FF6B35]/40 my-6 max-w-3xl","children":[["$","div","0",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["Resting Position (Still Eating)",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Place fork and knife in an inverted 'V' formation across the center of the plate (tips pointing toward 12 o'clock, handles at 4 and 8 o'clock). Tines point downward in Continental style."}]]}],["$","div","1",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["Finished Position (Ready to Clear)",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Place fork and knife parallel together either vertically (12 to 6 o'clock) or diagonally (11 to 5 o'clock) with knife blade facing inward and fork tines upward."}]]}],["$","div","2",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["Napkin Protocol",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Place napkin on lap immediately upon sitting (never tuck into collar). When stepping away temporarily, place loosely on your chair seat. At meal conclusion, place loosely on the left side of your place setting."}]]}],["$","div","3",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["Executive Social Taboos",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Never pick up dropped silverware (ask server for replacement); never use toothpicks at the table; pass salt and pepper shakers together as inseparable companions; zero mobile phones on the table."}]]}]]}],"$undefined",["$","div",null,{"className":"my-8 p-6 sm:p-8 rounded-2xl bg-[#FFF1EB] border-l-4 border-l-[#FF6B35] relative","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-quote w-8 h-8 text-[#FF6B35]/25 absolute top-5 right-5","children":[["$","path","rib7q0",{"d":"M16 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"}],["$","path","1ymkrd",{"d":"M5 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"}],"$undefined"]}],["$","span",null,{"className":"text-xs font-mono uppercase tracking-wider text-[#FF6B35] font-bold block mb-2","children":"The Golden Rule of Table Manners"}],["$","blockquote",null,{"className":"text-base sm:text-lg font-serif italic text-[#171717] leading-relaxed max-w-2xl","children":["“","Never pick up dropped silverware from the floor, never use toothpicks at the table, and always pass salt and pepper together as inseparable partners.","”"]}],["$","div",null,{"className":"text-xs font-mono text-[#686868] mt-3","children":["— ","Emily Post Institute"]}]]}]]}]]}],["$","$L3",null,{"componentId":"dining-table"}],["$","$L4",null,{"synthesis":{"topicMeaning":"Formal dining etiquette and executive table manners govern professional conduct during business meals, client lunches, and official academic functions. Far from superficial decorum, dining protocol is executive body language demonstrating self-discipline, respect for hosts and colleagues, spatial mindfulness, and social tact in high-stakes networking environments.","coreConceptsLearned":["The Architectural Geography of the Formal Table Setting: The 'Outside-In' Cutlery Rule (progressing inward through successive courses).","The 'b' and 'd' Spatial Mnemonic: Forming circular loops with thumb and index fingers under the table to instantly identify bread on the left ('b') and drink on the right ('d').","International Dining Styles: Continental/European Style (fork held continuously in left hand tines down, knife in right hand) vs. American 'Zig-Zag' Style (switching hands).","Utensil Signaling Codes: Resting Position (inverted 'V' across plate) signaling ongoing eating; Finished Position (knife and fork placed parallel vertically or diagonally at 11-to-5) signaling clearing.","Executive Dining Protocols: Immediate napkin deployment onto lap (never tucked into collar), passing salt and pepper together as inseparable companions, and zero mobile phones or grooming on the table."],"whyItMattersInIT":"High-value technology contracts, corporate partnerships, investor angel rounds, and leadership appointments are frequently negotiated over formal business lunches and dinners. A software founder or technical lead who displays clumsy table manners, talks while chewing, or ignores dining decorum inadvertently signals a lack of refinement and self-discipline to prospective business partners.","activityConnections":[{"activityTitle":"Executive Client Lunches & Partner Meetings for LA'CEDRA","activityType":"Entrepreneurship (LA'CEDRA)","description":"Conducting business discussions over lunch with prospective corporate software clients, applying the Continental dining style to maintain conversational poise without clumsy utensil switching."},{"activityTitle":"Academic Banquets, Networking Dinners & Institutional Galas","activityType":"Academic (SLIIT City Uni)","description":"Attending university academic ceremonies, faculty dinners, and industry networking events at SLIIT City Uni, applying table setting geography and utensil signaling with effortless composure."}],"practicalApplications":[{"scenario":"Navigating a Complex Multi-Course Formal Business Dinner","implementation":"Silently applying the 'outside-in' rule for flatware, using the `b` and `d` finger mnemonic under the table, and placing the napkin neatly on the chair seat if briefly excusing oneself from the table."},{"scenario":"Balancing Technical Dialogue with Meal Progression","implementation":"Cutting only one or two bite-sized portions at a time, chewing thoroughly before speaking, and resting flatware in the inverted 'V' position while articulating technical concepts."}],"personalReflection":{"narrative":"Before this chapter, I viewed dining etiquette as an archaic formality. Practicing the Continental style and understanding the architectural geography of place settings made me realize that table manners are an extension of personal mindfulness and executive presence. Being able to navigate a formal meal with effortless poise allows you to focus 100% on the business conversation.","editableInputPrompt":"[Editable Reflection Slot: Add your personal thoughts on attending a formal dinner, family celebration, or client lunch where you consciously observed dining protocol.]"},"areasForImprovement":["Consistent practice of the Continental dining style during everyday meals to make the utensil handling completely second nature.","Remembering to pass salt and pepper shakers together as inseparable companions, even when only one seasoning is requested."],"keyTakeaways":["Dining etiquette is silent executive body language; flawless table manners reassure clients and partners of your attention to detail.","The 'Outside-In' cutlery rule and the 'b' and 'd' hand mnemonic eliminate social anxiety, allowing you to focus on building genuine professional relationships."]},"chapterNumber":"09","chapterTitle":"Dining Etiquette & Table Manners"}],["$","div",null,{"className":"my-12 pt-8 border-t border-[#E5E5E2] space-y-6","children":[["$","div",null,{"className":"flex items-center space-x-2","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark w-4 h-4 text-[#FF6B35]","children":[["$","path","1fy3hk",{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"}],"$undefined"]}],["$","h3",null,{"className":"text-xs font-mono uppercase tracking-widest text-[#FF6B35] font-bold","children":"Core Academic Takeaways"}]]}],["$","div",null,{"className":"grid grid-cols-1 md:grid-cols-2 gap-6","children":[["$","div","0",{"className":"p-5 rounded-2xl bg-white border border-[#E5E5E2] flex items-start space-x-3 shadow-subtle hover:border-[#171717] transition-all","children":[["$","span",null,{"className":"font-mono text-xs font-bold text-[#FF6B35] shrink-0 mt-0.5","children":["0",1,"."]}],["$","p",null,{"className":"text-xs sm:text-sm text-[#171717] leading-relaxed font-sans","children":"Always follow the 'Outside-In' rule for silverware and the 'b' and 'd' finger mnemonic for bread (left) and drinks (right)."}]]}],["$","div","1",{"className":"p-5 rounded-2xl bg-white border border-[#E5E5E2] flex items-start space-x-3 shadow-subtle hover:border-[#171717] transition-all","children":[["$","span",null,{"className":"font-mono text-xs font-bold text-[#FF6B35] shrink-0 mt-0.5","children":["0",2,"."]}],["$","p",null,{"className":"text-xs sm:text-sm text-[#171717] leading-relaxed font-sans","children":"Continental dining (fork in left hand, knife in right, no switching) is the international standard for executive dining."}]]}],["$","div","2",{"className":"p-5 rounded-2xl bg-white border border-[#E5E5E2] flex items-start space-x-3 shadow-subtle hover:border-[#171717] transition-all","children":[["$","span",null,{"className":"font-mono text-xs font-bold text-[#FF6B35] shrink-0 mt-0.5","children":["0",3,"."]}],["$","p",null,{"className":"text-xs sm:text-sm text-[#171717] leading-relaxed font-sans","children":"Utensil placement signals service staff silently: inverted 'V' for resting; parallel together at 11-to-5 or 12-to-6 for finished."}]]}],["$","div","3",{"className":"p-5 rounded-2xl bg-white border border-[#E5E5E2] flex items-start space-x-3 shadow-subtle hover:border-[#171717] transition-all","children":[["$","span",nul