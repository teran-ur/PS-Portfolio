 border-[#E5E5E2] shadow-subtle space-y-6","children":[["$","div",null,{"children":[["$","span",null,{"className":"text-xs font-mono uppercase tracking-widest text-[#FF6B35] font-bold block mb-2","children":"Curriculum Overview & Context"}],["$","p",null,{"className":"text-base sm:text-lg text-[#171717] leading-relaxed font-sans font-medium","children":"Details the structural anatomy of an ATS-compliant modern CV. Contrasts Chronological, Functional, and Combination formats, and establishes the definitive boundaries between a CV and a Resume."}]]}],["$","div",null,{"className":"pt-6 border-t border-[#E5E5E2] space-y-3","children":[["$","div",null,{"className":"flex items-center space-x-2","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-graduation-cap w-4 h-4 text-[#FF6B35]","children":[["$","path","j76jl0",{"d":"M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"}],["$","path","1lu8f3",{"d":"M22 10v6"}],["$","path","1r8lef",{"d":"M6 12.5V16a6 3 0 0 0 12 0v-3.5"}],"$undefined"]}],["$","h4",null,{"className":"text-xs font-mono uppercase tracking-widest text-[#171717] font-bold","children":"Core Competencies & Learning Objectives"}]]}],["$","ul",null,{"className":"grid grid-cols-1 md:grid-cols-2 gap-3 text-xs sm:text-sm text-[#404040]","children":[["$","li","0",{"className":"flex items-start space-x-2.5 font-sans","children":[["$","span",null,{"className":"text-[#FF6B35] font-mono font-bold mt-0.5 shrink-0","children":"→"}],["$","span",null,{"children":"Identify the 6 essential anatomical sections of a winning curriculum vitae."}]]}],["$","li","1",{"className":"flex items-start space-x-2.5 font-sans","children":[["$","span",null,{"className":"text-[#FF6B35] font-mono font-bold mt-0.5 shrink-0","children":"→"}],["$","span",null,{"children":"Select appropriately between Chronological, Functional, and Hybrid CV formats."}]]}],["$","li","2",{"className":"flex items-start space-x-2.5 font-sans","children":[["$","span",null,{"className":"text-[#FF6B35] font-mono font-bold mt-0.5 shrink-0","children":"→"}],["$","span",null,{"children":"Optimize career documents to achieve 90%+ parse rates through Applicant Tracking Systems (ATS)."}]]}],["$","li","3",{"className":"flex items-start space-x-2.5 font-sans","children":[["$","span",null,{"className":"text-[#FF6B35] font-mono font-bold mt-0.5 shrink-0","children":"→"}],["$","span",null,{"children":"Distinguish between an academic/global CV and a targeted private-sector Resume."}]]}],["$","li","4",{"className":"flex items-start space-x-2.5 font-sans","children":[["$","span",null,{"className":"text-[#FF6B35] font-mono font-bold mt-0.5 shrink-0","children":"→"}],["$","span",null,{"children":"Employ powerful action verbs and quantifiable metrics to validate technical achievements."}]]}]]}]]}]]}],["$","div",null,{"className":"space-y-8","children":[["$","section",null,{"className":"py-8 border-b border-[#E5E5E2] space-y-6","children":[["$","div",null,{"className":"space-y-1","children":[["$","h2",null,{"className":"text-2xl sm:text-3xl font-display font-bold text-[#171717] tracking-tight","children":"The 6 Essential Anatomy Components of a Winning CV"}],["$","p",null,{"className":"text-sm font-mono text-[#FF6B35] font-semibold","children":"Systematic Engineering of Career Data"}]]}],["$","div",null,{"className":"space-y-4 max-w-3xl","children":[["$","p","0",{"className":"text-base text-[#404040] leading-relaxed font-sans","children":"Recruiters spend an average of six to seven seconds on an initial CV scan. A winning document must feature an immediate visual hierarchy that guides the human eye directly to relevant competencies and quantifiable value."}]]}],["$","div",null,{"className":"space-y-3 pl-4 sm:pl-6 border-l-2 border-[#FF6B35]/40 my-6 max-w-3xl","children":[["$","div","0",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["1. Header & Verified Contact Data",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Full legal name in prominent display, verified professional email (e.g. first.last@domain.com, no casual handles), phone number, location, and verified links to LinkedIn and GitHub."}]]}],["$","div","1",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["2. Tailored Professional Summary",":"]}],["$","span",null,{"className":"text-[#555555]","children":"High-impact 3-line elevator pitch synthesizing domain specialty, key technologies, and concrete value proposition. Eliminates outdated, self-serving 'Objective' statements."}]]}],["$","div","2",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["3. Work & Project Experience",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Reverse chronological order, dynamic action verbs ('Architected', 'Refactored', 'Optimized'), and metrics-driven bullet points (e.g. 'Reduced query latency by 38%')."}]]}],["$","div","3",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["4. Education & Academic Honors",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Degree title, university, graduation year (or expected date), GPA/class honors, and specialized relevant coursework."}]]}],["$","div","4",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["5. Categorized Skills Inventory",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Systematically segregated into Languages, Frameworks, Developer Tools, Databases, and Interpersonal proficiencies."}]]}],["$","div","5",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["6. Verified Referees",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Two professional or academic contacts with verified corporate titles, official institutional email addresses, and confirmed prior consent."}]]}]]}],"$undefined","$undefined"]}],["$","section",null,{"className":"py-8 border-b border-[#E5E5E2] space-y-6","children":[["$","div",null,{"className":"space-y-1","children":[["$","h2",null,{"className":"text-2xl sm:text-3xl font-display font-bold text-[#171717] tracking-tight","children":"CV Format Comparative Matrix"}],["$","p",null,{"className":"text-sm font-mono text-[#FF6B35] font-semibold","children":"Selecting the Right Layout for Your Career Stage"}]]}],["$","div",null,{"className":"space-y-4 max-w-3xl","children":[["$","p","0",{"className":"text-base text-[#404040] leading-relaxed font-sans","children":"Different career narratives require different architectural containers. Using the wrong format can emphasize employment gaps or conceal critical technical skills."}]]}],"$undefined",["$","div",null,{"className":"my-8 overflow-x-auto rounded-2xl border border-[#E5E5E2] bg-white shadow-subtle","children":[["$","table",null,{"className":"w-full text-left text-xs md:text-sm border-collapse","children":[["$","thead",null,{"children":["$","tr",null,{"className":"bg-[#F7F7F5] border-b border-[#E5E5E2]","children":[["$","th","0",{"className":"py-3.5 px-4 font-mono font-semibold uppercase tracking-wider text-[#171717] text-[11px]","children":"Format Archetype"}],["$","th","1",{"className":"py-3.5 px-4 font-mono font-semibold uppercase tracking-wider text-[#171717] text-[11px]","children":"Core Structural Focus"}],["$","th","2",{"className":"py-3.5 px-4 font-mono font-semibold uppercase tracking-wider text-[#171717] text-[11px]","children":"Ideal Candidate Profile"}],["$","th","3",{"className":"py-3.5 px-4 font-mono font-semibold uppercase tracking-wider text-[#171717] text-[11px]","children":"ATS Friendliness"}]]}]}],["$","tbody",null,{"className":"divide-y divide-[#E5E5E2] bg-white","children":[["$","tr","0",{"className":"hover:bg-[#F7F7F5]/50 transition-colors","children":[["$","td","0",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Chronological CV"}],["$","td","1",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Reverse time progression; emphasizes employer names and tenure length."}],["$","td","2",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Candidates with steady, continuous progression in the same industry."}],["$","td","3",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Extremely High (Standard industry parser default)."}]]}],["$","tr","1",{"className":"hover:bg-[#F7F7F5]/50 transition-colors","children":[["$","td","0",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Functional (Skills-Based)"}],["$","td","1",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Groups accomplishments by skill competencies rather than dates."}],["$","td","2",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Career switchers or candidates with significant gaps in employment."}],["$","td","3",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Moderate (Can confuse chronological parser algorithms)."}]]}],["$","tr","2",{"className":"hover:bg-[#F7F7F5]/50 transition-colors","children":[["$","td","0",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Combination / Hybrid"}],["$","td","1",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Blends a prominent skill competency matrix with chronological work history."}],["$","td","2",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Modern tech undergraduates, full-stack engineers, versatile specialists."}],["$","td","3",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"High (When styled with clean semantic headers)."}]]}]]}]]}],"$undefined"]}],"$undefined"]}],["$","section",null,{"className":"py-8 border-b border-[#E5E5E2] space-y-6","children":[["$","div",null,{"className":"space-y-1","children":[["$","h2",null,{"className":"text-2xl sm:text-3xl font-display font-bold text-[#171717] tracking-tight","children":"ATS Optimization & The CV vs. Resume Distinction"}],["$","p",null,{"className":"text-sm font-mono text-[#FF6B35] font-semibold","children":"Navigating Algorithmic Gatekeepers"}]]}],["$","div",null,{"className":"space-y-4 max-w-3xl","children":[["$","p","0",{"className":"text-base text-[#404040] leading-relaxed font-sans","children":"Over 75% of job applications are filtered out by Applicant Tracking Systems before a human recruiter ever sees them."}],["$","p","1",{"className":"text-base text-[#404040] leading-relaxed font-sans","children":"ATS engines struggle with multi-column table layouts, text placed inside graphical images, complex icons, and non-standard header names."}]]}],["$","div",null,{"className":"space-y-3 pl-4 sm:pl-6 border-l-2 border-[#FF6B35]/40 my-6 max-w-3xl","children":[["$","div","0",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["CV (Curriculum Vitae)",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Comprehensive, multi-page (2-5+ pages) academic and professional ledger documenting full career history, publications, research, teaching, and credentials. Standard in academia and medicine."}]]}],["$","div","1",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["Resume",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Highly concise, strictly 1-2 page tailored marketing document custom-built for a specific private-sector vacancy, highlighting only relevant achievements."}]]}]]}],"$undefined",["$","div",null,{"className":"my-8 p-6 sm:p-8 rounded-2xl bg-[#FFF1EB] border-l-4 border-l-[#FF6B35] relative","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-quote w-8 h-8 text-[#FF6B35]/25 absolute top-5 right-5","children":[["$","path","rib7q0",{"d":"M16 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"}],["$","path","1ymkrd",{"d":"M5 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"}],"$undefined"]}],["$","span",null,{"className":"text-xs font-mono uppercase tracking-wider text-[#FF6B35] font-bold block mb-2","children":"Golden Rules for ATS Parsing"}],["$","blockquote",null,{"className":"text-base sm:text-lg font-serif italic text-[#171717] leading-relaxed max-w-2xl","children":["“","Use standard fonts (Inter, Arial, Calibri), eliminate text boxes and graphics, use universal section titles ('Work Experience', 'Skills', 'Education'), and match exact keywords from the target job specification.","”"]}],["$","div",null,{"className":"text-xs font-mono text-[#686868] mt-3","children":["— ","Innes (2016)"]}]]}]]}]]}],["$","$L3",null,{"componentId":"ats-analyzer"}],["$","$L4",null,{"synthesis":{"topicMeaning":"A curriculum vitae (CV) is a comprehensive, strategically engineered marketing document designed to present an individual's academic trajectory, technical competencies, verifiable project outcomes, and professional character. It must be optimized simultaneously for automated Applicant Tracking Systems (ATS) and the rapid 6-to-10 second cognitive scan of human technical recruiters.","coreConceptsLearned":["The 6 Essential Anatomy Components: Contact Header, Professional Summary, Experience/Projects, Education, Categorized Skills, and Referees.","CV Format Typology: Chronological (continuous progression), Functional (skills-based for transitions), and Combination/Hybrid (the modern gold standard).","ATS Parsing Architecture: Standard system fonts, avoidance of unparseable graphic columns or text boxes, standard section titles, and job-description keyword matching.","Action Verb & Metric Formula: Leading every bullet point with dynamic verbs ('Architected', 'Engineered', 'Provisioned', 'Deployed') linked to quantifiable results.","CV vs. Resume Distinction: Comprehensive multi-page academic/professional record vs. highly condensed 1–2 page private-sector marketing document."],"whyItMattersInIT":"The global tech industry relies heavily on automated ATS filters to screen thousands of resumes. A developer with exceptional full-stack skills will be automatically discarded before reaching an engineering manager if their document utilizes non-standard fonts, unparseable tables, or lacks relevant technical keywords. Precision formatting is a non-negotiable entry barrier.","activityConnections":[{"activityTitle":"Drafting an ATS-Optimized Hybrid CV for HDIT Studies","activityType":"Academic (SLIIT City Uni)","description":"Synthesizing my Higher Diploma in Information Technology from SLIIT City Uni, diplomas in IT and English from IMBS Green Campus, and school background at Prince of Wales College into a structured, parser-friendly hybrid CV format."},{"activityTitle":"Documenting Entrepreneurial Leadership & Full-Stack Projects","activityType":"Software Development","description":"Translating real-world roles (Co-Founder of LA'CEDRA) and technical projects (LA'CEDRA Website, TechMart, ApPoint, Security Assessment) into impact-driven bullet points pairing action verbs with concrete technical scope."}],"practicalApplications":[{"scenario":"Customizing CV Keywords for Specific Software Engineering Roles","implementation":"Tailoring technical skill categories (Frontend, Backend, Databases, Tools, Infrastructure) to mirror the exact keyword nomenclature required by corporate software job descriptions."},{"scenario":"Executive Professional Summary Crafting","implementation":"Composing a 3-line elevator summary presenting myself as an IT undergraduate at SLIIT City Uni passionate about software engineering, venture leadership, and continuous interpersonal growth."}],"personalReflection":{"narrative":"Drafting my CV according to academic guidelines eliminated the cluttered formatting and passive language of my earlier drafts. I learned to replace vague phrases like 'was responsible for building a website' with precise engineering statements like 'Engineered a multi-page responsive corporate web platform using Next.js, TypeScript, and Tailwind CSS'. The difference in professional authority is immense.","editableInputPrompt":"[Editable Reflection Slot: Add your personal thoughts on tailoring your CV for software engineering roles vs. technology management opportunities.]"},"areasForImprovement":["Continuously updating project bullet points with verified performance benchmarks and user metrics as systems scale.","Maintaining formal, verified contact details and prior consent records for academic and industry referees."],"keyTakeaways":["Format for the ATS parser; write for the human engineering hiring manager.","Every bullet point must pair an active power verb with a technical context and a verifiable positive outcome."]},"chapterNumber":"04","chapterTitle":"CV Writing & Career Documents"}],["$","div",null,{"className":"my-12 pt-8 border-t border-[#E5E5E2] space-y-6","children":[["$","div",null,{"className":"flex items-center space-x-2","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark w-4 h-4 text-[#FF6B35]","children":[["$","path","1fy3hk",{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"}],"$undefined"]}],["$","h3",null,{"className":"text-xs font-mono uppercase tracking-widest text-[#FF6B35] font-bold","children":"Core Academic Takeaways"}]]}],["$","div",null,{"className":"grid grid-cols-1 md:grid-cols-2 gap-6","children":[["$","div","0",{"className":"p-5 rounded-2xl bg-white border border-[#E5E5E2] flex items-start space-x-3 shadow-subtle hover:border-[#171717] transition-all","children":[["$","span",null,{"className":"font-mono text-xs font-bold text-[#FF6B35] shrink-0 mt-0.5","children":["0",1,"."]}],["$","p",null,{"className":"text-xs sm:text-sm text-[#171717] leading-relaxed font-sans","children":"A winning CV contains 6 core components; the professional summary must be a 3-line value pitch, not an outdated objective."}]]}],["$","div","1",{"className":"p-5 rounded-2xl bg-white border border-[#E5E5E2] flex items-start space-x-3 shadow-subtle hover:border-[#171717] transition-all","children":[["$","span",null,{"className":"font-mono text-xs font-bold text-[#FF6B35] shrink-0 mt-0.5","children":["0",2,"."]}],["$","p",null,{"className":"text-xs sm:text-sm text-[#171717] leading-relaxed font-sans","children":"The Hybrid/Combination format is the gold standard for tech students, combining technical skill clusters with reverse-chronological evidence."}]]}],["$","div","2",{"className":"p-5 rounded-2xl bg-white border border-[#E5E5E2] flex items-start space-x-3 shadow-subtle hover:border-[#171717] tran