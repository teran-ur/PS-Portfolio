ll bg-[#FFF1EB] text-[#FF6B35] font-bold tracking-wider","children":["Module ","05"]}],["$","span",null,{"className":"text-xs font-mono uppercase text-[#171717] font-semibold","children":"Executive Communication"}],["$","span",null,{"className":"text-[#8E8E93]","children":"•"}],["$","span",null,{"className":"flex items-center space-x-1.5 text-xs text-[#686868] font-mono","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-clock w-3.5 h-3.5 text-[#FF6B35]","children":[["$","circle","1mglay",{"cx":"12","cy":"12","r":"10"}],["$","polyline","68esgv",{"points":"12 6 12 12 16 14"}],"$undefined"]}],["$","span",null,{"children":["8 min read"," read"]}]]}]]}],["$","div",null,{"className":"space-y-2 relative z-10","children":[["$","h1",null,{"className":"text-4xl sm:text-5xl md:text-6xl font-display font-extrabold text-[#171717] tracking-tight leading-[1]","children":"Speaking Skills & Effective Meetings"}],["$","p",null,{"className":"text-xl font-display font-medium text-[#404040] pt-1","children":"The 7 C's of Communication, Meeting Governance & The 10-Point Planning Audit"}]]}],["$","div",null,{"className":"pt-4 flex flex-wrap items-center justify-between gap-4 text-xs font-mono border-t border-[#E5E5E2] relative z-10","children":[["$","div",null,{"className":"flex items-center space-x-3","children":[["$","span",null,{"className":"text-[#FF6B35] font-bold","children":"Academic Lead:"}],["$","span",null,{"className":"font-semibold text-[#171717]","children":"Mrs. Ishara Raviharee Weerasinghe"}],["$","span",null,{"className":"text-[#8E8E93]","children":["(","Senior Lecturer in English | Lecturer In Charge",")"]}]]}],["$","div",null,{"className":"text-[#8E8E93]","children":"SLIIT City Uni • Professional Skills Assessment Standard"}]]}]]}],["$","div",null,{"className":"p-8 md:p-10 rounded-3xl bg-white border border-[#E5E5E2] shadow-subtle space-y-6","children":[["$","div",null,{"children":[["$","span",null,{"className":"text-xs font-mono uppercase tracking-widest text-[#FF6B35] font-bold block mb-2","children":"Curriculum Overview & Context"}],["$","p",null,{"className":"text-base sm:text-lg text-[#171717] leading-relaxed font-sans font-medium","children":"Explores the 7 C's of executive verbal delivery and examines meeting governance types. Provides the 10-point planning audit checklist to eliminate corporate meeting bloat and enforce timekeeping discipline."}]]}],["$","div",null,{"className":"pt-6 border-t border-[#E5E5E2] space-y-3","children":[["$","div",null,{"className":"flex items-center space-x-2","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-graduation-cap w-4 h-4 text-[#FF6B35]","children":[["$","path","j76jl0",{"d":"M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"}],["$","path","1lu8f3",{"d":"M22 10v6"}],["$","path","1r8lef",{"d":"M6 12.5V16a6 3 0 0 0 12 0v-3.5"}],"$undefined"]}],["$","h4",null,{"className":"text-xs font-mono uppercase tracking-widest text-[#171717] font-bold","children":"Core Competencies & Learning Objectives"}]]}],["$","ul",null,{"className":"grid grid-cols-1 md:grid-cols-2 gap-3 text-xs sm:text-sm text-[#404040]","children":[["$","li","0",{"className":"flex items-start space-x-2.5 font-sans","children":[["$","span",null,{"className":"text-[#FF6B35] font-mono font-bold mt-0.5 shrink-0","children":"→"}],["$","span",null,{"children":"Apply the 7 C's of Executive Communication across verbal presentations and meetings."}]]}],["$","li","1",{"className":"flex items-start space-x-2.5 font-sans","children":[["$","span",null,{"className":"text-[#FF6B35] font-mono font-bold mt-0.5 shrink-0","children":"→"}],["$","span",null,{"children":"Distinguish between meeting typologies: Agile Standups, Customer Negotiations, Board Meetings, AGMs, and EGMs."}]]}],["$","li","2",{"className":"flex items-start space-x-2.5 font-sans","children":[["$","span",null,{"className":"text-[#FF6B35] font-mono font-bold mt-0.5 shrink-0","children":"→"}],["$","span",null,{"children":"Execute the 10-point meeting planning checklist to ensure strict outcome-oriented facilitation."}]]}],["$","li","3",{"className":"flex items-start space-x-2.5 font-sans","children":[["$","span",null,{"className":"text-[#FF6B35] font-mono font-bold mt-0.5 shrink-0","children":"→"}],["$","span",null,{"children":"Master the role of Chairperson as diplomatic referee: moderating dominant voices and drawing out quiet contributors."}]]}]]}]]}]]}],["$","div",null,{"className":"space-y-8","children":[["$","section",null,{"className":"py-8 border-b border-[#E5E5E2] space-y-6","children":[["$","div",null,{"className":"space-y-1","children":[["$","h2",null,{"className":"text-2xl sm:text-3xl font-display font-bold text-[#171717] tracking-tight","children":"The 7 C's of Executive Communication"}],["$","p",null,{"className":"text-sm font-mono text-[#FF6B35] font-semibold","children":"The Universal Standard for Verbal & Written Clarity"}]]}],["$","div",null,{"className":"space-y-4 max-w-3xl","children":[["$","p","0",{"className":"text-base text-[#404040] leading-relaxed font-sans","children":"Communication failure in engineering teams is rarely technical; it is almost always a breakdown in clarity, precision, or courtesy. The 7 C's provide an actionable filter for every spoken or written exchange."}]]}],["$","div",null,{"className":"space-y-3 pl-4 sm:pl-6 border-l-2 border-[#FF6B35]/40 my-6 max-w-3xl","children":[["$","div","0",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["1. Clear",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Unambiguous message with simple language, free from confusing corporate jargon or obscure acronyms."}]]}],["$","div","1",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["2. Concise",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Economical with the listener's time; sticking strictly to the point without filler or circular explanations."}]]}],["$","div","2",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["3. Concrete",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Supported by solid facts, exact data, and verifiable metrics rather than vague abstractions."}]]}],["$","div","3",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["4. Correct",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Accurate information, proper grammar, verified technical statistics, and appropriate register."}]]}],["$","div","4",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["5. Coherent",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Logically structured with smooth transitions, ensuring each idea naturally connects to the next."}]]}],["$","div","5",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["6. Complete",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Contains all required details, deadlines, and context so the receiver can act without requesting clarification."}]]}],["$","div","6",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["7. Courteous",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Respectful, empathetic, professional tone that acknowledges the listener's perspective and time."}]]}]]}],"$undefined","$undefined"]}],["$","section",null,{"className":"py-8 border-b border-[#E5E5E2] space-y-6","children":[["$","div",null,{"className":"space-y-1","children":[["$","h2",null,{"className":"text-2xl sm:text-3xl font-display font-bold text-[#171717] tracking-tight","children":"Meeting Typologies & Governance"}],["$","p",null,{"className":"text-sm font-mono text-[#FF6B35] font-semibold","children":"Matching Structure to Strategic Purpose"}]]}],["$","div",null,{"className":"space-y-4 max-w-3xl","children":[["$","p","0",{"className":"text-base text-[#404040] leading-relaxed font-sans","children":"Meetings represent a massive expenditure of organizational capital. Ineffective meetings waste thousands of developer hours each month. Understanding the legal and operational structure of meetings ensures disciplined execution."}]]}],"$undefined",["$","div",null,{"className":"my-8 overflow-x-auto rounded-2xl border border-[#E5E5E2] bg-white shadow-subtle","children":[["$","table",null,{"className":"w-full text-left text-xs md:text-sm border-collapse","children":[["$","thead",null,{"children":["$","tr",null,{"className":"bg-[#F7F7F5] border-b border-[#E5E5E2]","children":[["$","th","0",{"className":"py-3.5 px-4 font-mono font-semibold uppercase tracking-wider text-[#171717] text-[11px]","children":"Meeting Classification"}],["$","th","1",{"className":"py-3.5 px-4 font-mono font-semibold uppercase tracking-wider text-[#171717] text-[11px]","children":"Frequency / Scope"}],["$","th","2",{"className":"py-3.5 px-4 font-mono font-semibold uppercase tracking-wider text-[#171717] text-[11px]","children":"Governance Rules & Formal Protocols"}]]}]}],["$","tbody",null,{"className":"divide-y divide-[#E5E5E2] bg-white","children":[["$","tr","0",{"className":"hover:bg-[#F7F7F5]/50 transition-colors","children":[["$","td","0",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Agile Standup / Sprint Sync"}],["$","td","1",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Daily (15 mins)"}],["$","td","2",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Strict timebox; three questions: What was completed? What is next? What blockers exist?"}]]}],["$","tr","1",{"className":"hover:bg-[#F7F7F5]/50 transition-colors","children":[["$","td","0",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Customer / Client Negotiation"}],["$","td","1",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Ad-hoc / Milestone-driven"}],["$","td","2",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Contractual alignment, value consensus, documented scope bounds, formal minutes."}]]}],["$","tr","2",{"className":"hover:bg-[#F7F7F5]/50 transition-colors","children":[["$","td","0",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Board Meeting"}],["$","td","1",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Monthly / Quarterly"}],["$","td","2",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Executive directors; legal fiduciary oversight, corporate governance, strategic capital allocation."}]]}],["$","tr","3",{"className":"hover:bg-[#F7F7F5]/50 transition-colors","children":[["$","td","0",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"AGM (Annual General Meeting)"}],["$","td","1",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Mandatory Annually"}],["$","td","2",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Open to all shareholders; financial statement approvals, board elections, statutory voting."}]]}],["$","tr","4",{"className":"hover:bg-[#F7F7F5]/50 transition-colors","children":[["$","td","0",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"EGM (Extraordinary General Meeting)"}],["$","td","1",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Emergency / Special crisis"}],["$","td","2",{"className":"py-3.5 px-4 text-[#404040] align-top leading-relaxed text-xs","children":"Convened under company law for urgent matters requiring immediate shareholder vote."}]]}]]}]]}],"$undefined"]}],"$undefined"]}],["$","section",null,{"className":"py-8 border-b border-[#E5E5E2] space-y-6","children":[["$","div",null,{"className":"space-y-1","children":[["$","h2",null,{"className":"text-2xl sm:text-3xl font-display font-bold text-[#171717] tracking-tight","children":"The 10-Point Meeting Planning Checklist"}],["$","p",null,{"className":"text-sm font-mono text-[#FF6B35] font-semibold","children":"Eliminating Waste and Enforcing Accountability"}]]}],["$","div",null,{"className":"space-y-4 max-w-3xl","children":[["$","p","0",{"className":"text-base text-[#404040] leading-relaxed font-sans","children":"A successful meeting begins 48 hours before anyone enters the conference room and finishes only when action minutes are verified and delivered."}]]}],["$","div",null,{"className":"space-y-3 pl-4 sm:pl-6 border-l-2 border-[#FF6B35]/40 my-6 max-w-3xl","children":[["$","div","0",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["1. Explicit Purpose",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Define clear objectives; if the outcome can be achieved via an email, cancel the meeting."}]]}],["$","div","1",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["2. Timed Agenda",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Circulate an agenda with exact minute allocations at least 48 hours in advance."}]]}],["$","div","2",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["3. Curated Attendees",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Invite only decision-makers and vital contributors; eliminate spectator bloat."}]]}],["$","div","3",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["4. Optimized Environment",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Maintain a cool ambient room temperature (cooler rooms promote mental alertness and combat drowsiness)."}]]}],["$","div","4",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["5. Technology AV Check",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Pre-test projectors, video conferencing links, and screen sharing 10 minutes prior."}]]}],["$","div","5",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["6. Chairperson as Referee",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Diplomatically rein in dominant talkers and actively invite insights from quiet team members."}]]}],["$","div","6",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["7. Punctual Discipline",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Start strictly on time (never wait for latecomers) and end at or before the scheduled time."}]]}],["$","div","7",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["8. Action-Oriented Minutes",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Record explicit decisions, assigned owners, and agreed deadlines rather than conversational transcripts."}]]}],["$","div","8",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["9. Immediate Distribution",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Circulate summary minutes and task matrices within 24 hours of meeting completion."}]]}],["$","div","9",{"className":"text-sm text-[#404040] leading-relaxed","children":[["$","strong",null,{"className":"text-[#171717] font-semibold mr-1.5 font-sans","children":["10. Follow-up Accountability",":"]}],["$","span",null,{"className":"text-[#555555]","children":"Verify that assignees execute agreed action items prior to the next scheduled sync."}]]}]]}],"$undefined",["$","div",null,{"className":"my-8 p-6 sm:p-8 rounded-2xl bg-[#FFF1EB] border-l-4 border-l-[#FF6B35] relative","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-quote w-8 h-8 text-[#FF6B35]/25 absolute top-5 right-5","children":[["$","path","rib7q0",{"d":"M16 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"}],["$","path","1ymkrd",{"d":"M5 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z"}],"$undefined"]}],["$","span",null,{"className":"text-xs font-mono uppercase tracking-wider text-[#FF6B35] font-bold block mb-2","children":"The Chairperson's Golden Rule"}],["$","blockquote",null,{"className":"text-base sm:text-lg font-serif italic text-[#171717] leading-relaxed max-w-2xl","children":["“","A great chairperson is like a diplomatic sports referee: they do not dominate the game; they ensure fair participation, keep the ball moving forward, and penalize time-wasting.","”"]}],["$","div",null,{"className":"text-xs font-mono text-[#686868] mt-3","children":["— ","Meeting Governance Protocol"]}]]}]]}]]}],["$","$L3",null,{"componentId":"meeting-checklist"}],["$","$L4",null,{"synthesis":{"topicMeaning":"Executive speaking skills and meeting governance involve the disciplined delivery of verbal messages and the structured moderation of organizational syncs to eliminate operational drift, respect collective time, and achieve decisive consensus. It pairs the 7 C's of Communication with strict meeting typologies, timed agendas, and parliamentary minutes.","coreConceptsLearned":["The 7 C's of Executive Communication: Clear, Concise, Concrete, Correct, Coherent, Complete, and Courteous.","Meeting Typology & Governance: Internal Agile Syncs (standups, retrospectives), Client Negotiations, and Executive Governance (Board Meetings, AGMs).","The 10-Point Meeting Planning Checklist: Clear purpose, timed agenda circulated 48h prior, participant curation, environment optimization, tech testing, timekeeping, minutes, and accountability follow-up.","Chairperson as Diplomatic Referee: Moderating dominant participants, drawing out introverted developers, and preventing tangent drift.","Meeting Minutes Protocol: Formally recording decisions, assigned owners, and hard delivery deadlines within 24 hours."],"whyItMattersInIT":"The technology sector suffers chronically from 'meeting fatigue' and unproductive daily syncs where hours are lost to unstructured technical debates. Engineers who master concise public speaking and structured meeting facilitation keep sprint velocity high, prevent miscommunication between technical and business teams, and command leadership respect.","activityConnections":[{"activityTitle":"Facilitating Agile Sprint Syncs in University Projects","activityType":"Academic (SLIIT City Uni)","description":"Applying the 10-point checklist to group software development meetings at SLIIT City Uni, setting 15-minute standup caps, and circulating action items to ensure equitable workload distribution across cohort members."},{"activityTitle":"Leading Client Discovery & Solution Presentations at LA'CEDRA","activityType":"Entrepreneurship (LA'CEDRA)","description":"Presenting proposed system architectures, POS solutions, and web deliverables to prospective commercial clients, using the 7 C's to explain complex technical concepts in accessible, value-focused terms."}],"practicalApplications":[{"scenario":"Technical Architecture Review Presentations","implementation":"Applying the 7 C's (Concrete, Concise, Clear) to present system trade-offs—such as choosing between SQL and NoSQL for the TechMart project—without confusing non-technical stakeholders."},{"scenario":"Chairing a Client Requirements & Scope Meeting for LA'CEDRA","implementation":"Enforcing a timed 45-minute agenda when reviewing client specifications, sprint deliverables, and system architecture timelines, ensuring every item concludes with an action owner and deadline."}],"personalReflection":{"narrative":"Learning the chairperson's role as a diplomatic referee fundamentally altered how I facilitate meetings. In past team projects, meetings frequently drifted because vocal members debated minor technical preferences endlessly. Establishing a timed agenda and gently steering discussions back to stated objectives dramatically improved team satisfaction and outcome clarity.","editableInputPrompt":"[Editable Reflection Slot: Add your personal thoughts on a team sync or presentation where applying meeting governance or the 7 C's resolved a blocker.]"},"areasForImprovement":["Exercising firmer diplomatic intervention when senior or vocal collaborators begin drifting into off-topic technical rabbit holes.","Standardizing the formal distribution of meeting minutes and action registers within 24 hours of every business session."],"keyTakeaways":["An unmanaged meeting is an operational tax on organizational productivity; every minute must have an agenda owner.","The 7 C's bridge the communication gap between technical development squads and commercial business leadership."]},"chapterNumber":"05","chapterTitle":"Speaking Skills & Effective Meetings"}],["$","div",null,{"className":"my-12 pt-8 border-t border-[#E5E5E2] space-y-6","children":[["$","div",null,{"className":"flex items-center space-x-2","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-bookmark w-4 h-4 text-[#FF6B35]","children":[["$","path","1fy3hk",{"d":"m19 21-7-4-7 4V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16z"}],"$undefined"]}],["$","h3",null,{"className":"text-xs font-mono uppercase tracking-widest text-[#FF6B35] font-bold","children":"Core Academic Takeaways"}]]}],["$","div",null,{"className":"grid grid-cols-1 md:grid-cols-2 gap-6","children":[["$","div","0",{"className":"p-5 rounded-2xl bg-white border border-[#E5E5E2] flex items-start space-x-3 shadow-subtle hover:border-[#171717] transition-all","children":[["$","span",null,{"className":"font-mono text-xs font-bold text-[#FF6B35] shrink-0 mt-0.5","children":["0",1,"."]}],["$","p",null,{"className":"text-xs sm:text-sm text-[#171717] leading-relaxed font-sans","children":"The 7 C's (Clear, Concise, Concrete, Correct, Coherent, Complete, Courteous) govern all executive communications."}]]}],["$","div","1",{"className":"p-5 rounded-2xl bg-white border border-[#E5E5E2] flex items-start space-x-3 shadow-subtle hover:border-[#171717] transition-all","children":[["$","span",null,{"className":"font-mono text-xs font-bold text-[#FF6B35] shrink-0 mt-0.5","children":["0",2,"."]}],["$","p",null,{"className":"text-xs sm:text-sm text-[#171717] leading-relaxed font-sans","children":"Corporate meetings span operational standups, customer negotiations, board meetings, AGMs, and emergency EGMs."}]]}],["$","div","2",{"className":"p-5 rounded-2xl bg-white border border-[#E5E5E2] flex items-start space-x-3 shadow-subtle hover:border-[#171717] transition-all","children":[["$","span",null,{"className":"font-mono text-xs font-bold text-[#FF6B35] shrink-0 mt-0.5","children":["0",3,"."]}],["$","p",null,{"className":"text-xs sm:text-sm text-[#171717] leading-relaxed font-sans","children":"The 10-Point Checklist guarantees that every meeting is purposeful, strictly timed, and rigorously followed up."}]]}],["$","div","3",{"className":"p-5 rounded-2xl bg-white border border-[#E5E5E2] flex items-start space-x-3 shadow-subtle hover:border-[#171717] transition-all","children":[["$","span",null,{"className":"font-mono text-xs font-bold text-[#FF6B35] shrink-0 mt-0.5","children":["0",4,"."]}],["$","p",null,{"className":"text-xs sm:text-sm text-[#171717] leading-relaxed font-sans","children":"Keeping meeting rooms cool promotes alertness; chairpersons must act as referees to curb ramblers and empower quiet voices."}]]}]]}]]}],["$","div",null,{"className":"space-y-6 pt-8 border-t border-[#E5E5E2]","children":[["$","div",null,{"className":"flex items-center space-x-2","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-book-open w-4 h-4 text-[#FF6B35]","children":[["$","path","1akyts",{"d":"M12 7v14"}],["$","path","ruj8y",{"d":"M3 18a1 1 0 0 1-1